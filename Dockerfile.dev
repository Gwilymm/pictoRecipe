# Dockerfile DEV - FrankenPHP + Symfony 7 + Puppeteer + Chromium (ALPINE)

FROM dunglas/frankenphp:1-php8.3-alpine

WORKDIR /app

# --------------------------------------------
# Install PHP extensions
# --------------------------------------------
RUN install-php-extensions \
    pdo_pgsql \
    pgsql \
    intl \
    zip \
    gd \
    xsl \
    gmp \
    apcu

# --------------------------------------------
# Install Chromium + deps + NodeJS
# --------------------------------------------
RUN apk add --no-cache \
    chromium \
    chromium-chromedriver \
    nss \
    freetype \
    harfbuzz \
    libstdc++ \
    ttf-freefont \
    nodejs \
    npm \
    git \
    curl

# Puppeteer env
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Install Puppeteer globally
RUN npm install -g puppeteer@latest

# Vérification
RUN node -e "console.log('Node OK'), console.log(process.version)" && \
    echo \"Chromium version:\" && chromium --version

# --------------------------------------------
# Copy project and composer
# --------------------------------------------
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer
COPY . .

# Install Composer dependencies (dev)
# Provide a build-time DATABASE_URL so Symfony auto-scripts (cache:clear) can run.
ENV DATABASE_URL="postgresql://app:motdepassefort@database:5432/picto?serverVersion=16&charset=utf8"
RUN composer install --no-interaction --prefer-dist

# Node deps (si tu utilises pnpm ou autre)
RUN npm install -g pnpm

# --------------------------------------------
# ENV DEV
# --------------------------------------------
ENV APP_ENV=dev \
    APP_DEBUG=1 \
    SERVER_NAME=:80

# --------------------------------------------
# Permissions
# --------------------------------------------
RUN mkdir -p var/cache var/log var/tmp && \
    chown -R www-data:www-data var

EXPOSE 80
