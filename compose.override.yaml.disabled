# ==========================================================
#  compose.override.yaml - Configuration de développement
#  Ce fichier override compose.yaml en mode développement
# ==========================================================

services:
  ###> Application en mode développement ###
  pictorecette-app:
    build:
      context: .
      dockerfile: Dockerfile
      target: composer-builder # Utilise le stage composer-builder en dev
      args:
        APP_ENV: dev # Installe les dépendances de dev
    environment:
      APP_ENV: dev
      APP_DEBUG: 1
      SERVER_NAME: :80
    volumes:
      # Monter le code source pour le hot-reload
      - ./:/app:cached
      - /app/var
      - /app/vendor
      - /app/node_modules
    # Logs lisibles
    tty: true
  ###< Application en mode développement ###

  ###> doctrine/doctrine-bundle ###
  database:
    ports:
      - "15432:5432"
  ###< doctrine/doctrine-bundle ###

  ###> symfony/mailer ###
  mailer:
    image: axllent/mailpit
    ports:
      - "1025"
      - "8025"
    environment:
      MP_SMTP_AUTH_ACCEPT_ANY: 1
      MP_SMTP_AUTH_ALLOW_INSECURE: 1
  ###< symfony/mailer ###
