{% extends 'base.html.twig' %}

{% block title %}PictoRecette — des recettes en pictogrammes{% endblock %}

{% block body %}
	<div class="space-y-12">
		{# Accroche #}
		<section class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]" aria-labelledby="home-title">
			<div class="space-y-6">
				<h1 id="home-title" class="text-3xl leading-tight">La cuisine expliquée avec des images</h1>
				<p class="max-w-xl text-lg">
					PictoRecette transforme une recette en fiche illustrée : chaque ingrédient, chaque ustensile et chaque étape a son pictogramme.
					Pour cuisiner en autonomie, apprendre ou accompagner.
				</p>
				<div class="flex flex-wrap gap-3">
					<a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
						{{ ux_icon('lucide:plus', { class: 'size-5', 'aria-hidden': 'true' }) }}
						Créer une recette
					</a>
					<a href="{{ path('app_recipe_index') }}" class="btn btn-outline">Voir les recettes</a>
				</div>
			</div>

			{# Aperçu d'une fiche (décoratif) #}
			<div class="space-y-3 rounded-box border border-base-300 bg-base-100 p-5" aria-hidden="true">
				<div class="flex items-center gap-3">
					<span class="section-mark bg-accent"></span>
					<p class="font-display text-lg font-semibold">Ingrédients</p>
				</div>
				<div class="grid grid-cols-3 gap-3">
					{% for item in [{q: '3', n: 'pommes'}, {q: '150 g', n: 'sucre'}, {q: '2', n: 'œufs'}] %}
						<div class="flex flex-col items-center gap-2 rounded-box border border-base-300 border-t-4 border-t-accent p-3 text-center">
							<div class="picto-tile w-full">{{ ux_icon('lucide:image', { class: 'size-1/3 text-base-300' }) }}</div>
							<span class="font-bold">{{ item.q }}</span>
							<span class="text-sm">{{ item.n }}</span>
						</div>
					{% endfor %}
				</div>
				<div class="flex items-start gap-4 rounded-box border border-base-300 p-4">
					<span class="step-badge">1</span>
					<p class="pt-1">Éplucher les pommes et les râper.</p>
				</div>
			</div>
		</section>

		{# Pour qui #}
		<section class="space-y-5" aria-labelledby="home-audience">
			<h2 id="home-audience" class="text-xl">Pour qui ?</h2>
			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{% for who in [
					{t: 'IME et ULIS', d: 'Des fiches lisibles pour les ateliers cuisine.'},
					{t: 'Orthophonistes', d: 'Un support visuel pour travailler le vocabulaire et la séquence.'},
					{t: 'Éducateurs', d: 'Préparer une activité en quelques minutes.'},
					{t: 'Familles', d: 'Cuisiner ensemble, pas à pas.'}
				] %}
					<li class="rounded-box border border-base-300 bg-base-100 p-5">
						<h3 class="text-base">{{ who.t }}</h3>
						<p class="mt-1 text-sm text-muted">{{ who.d }}</p>
					</li>
				{% endfor %}
			</ul>
		</section>

		{# Comment ça marche #}
		<section class="space-y-5" aria-labelledby="home-how">
			<h2 id="home-how" class="text-xl">Comment ça marche</h2>
			<ol class="grid gap-4 md:grid-cols-3">
				{% for step in [
					{t: 'Saisir ou importer la recette', d: 'À la main, ou depuis une adresse Marmiton, Cuisine AZ ou Papilles & Pupilles.'},
					{t: 'Choisir les pictogrammes', d: 'Parmi ARASAAC, OpenFoodFacts, Wikimedia Commons ou vos propres images.'},
					{t: 'Imprimer la fiche', d: 'Un PDF clair, prêt à afficher dans la cuisine.'}
				] %}
					<li class="flex items-start gap-4 rounded-box border border-base-300 bg-base-100 p-5">
						<span class="step-badge" aria-hidden="true">{{ loop.index }}</span>
						<div>
							<h3 class="text-base"><span class="sr-only">Étape {{ loop.index }} : </span>{{ step.t }}</h3>
							<p class="mt-1 text-sm text-muted">{{ step.d }}</p>
						</div>
					</li>
				{% endfor %}
			</ol>
		</section>

		{# Raccourcis #}
		<section class="grid gap-4 md:grid-cols-3" aria-label="Raccourcis">
			{% for link in [
				{t: 'Rechercher une recette', d: 'Trouver une idée sur les sites de recettes.', p: path('app_recipe_search'), i: 'lucide:search', bg: 'bg-step-soft'},
				{t: 'Importer une recette', d: 'Partir d’une recette existante.', p: path('app_recipe_import'), i: 'lucide:link', bg: 'bg-ingredient-soft'},
				{t: 'Gérer les pictogrammes', d: 'Ajouter vos propres images.', p: path('app_pictogram_index'), i: 'lucide:image', bg: 'bg-utensil-soft'}
			] %}
				<a href="{{ link.p }}" class="flex items-start gap-4 rounded-box p-5 no-underline {{ link.bg }} hover:outline-2 hover:outline-base-300">
					{{ ux_icon(link.i, { class: 'size-6 shrink-0', 'aria-hidden': 'true' }) }}
					<span>
						<span class="block font-display font-semibold">{{ link.t }}</span>
						<span class="mt-1 block text-sm">{{ link.d }}</span>
					</span>
				</a>
			{% endfor %}
		</section>
	</div>
{% endblock %}
