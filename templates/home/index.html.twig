{% extends 'base.html.twig' %}

{% block title %}PictoRecette - Créez des recettes accessibles avec des pictogrammes
{% endblock %}

{% block body %}
	<div
		class="min-h-screen bg-linear-to-br from-base-200 via-base-100 to-base-200">

		{# Hero principal - Landing #}
		<section class="hero min-h-[400px] md:min-h-[500px] lg:min-h-[600px] bg-linear-to-br from-primary/10 via-secondary/5 to-accent/10">
			<div class="hero-content text-center max-w-5xl px-4 py-8 md:py-12">
				<div>
					<div class="flex justify-center gap-2 md:gap-3 text-4xl md:text-5xl lg:text-6xl mb-4 md:mb-6">
						<span class="animate-bounce">🌟</span>
						<span class="animate-bounce" style="animation-delay: 0.1s">🖼️</span>
						<span class="animate-bounce" style="animation-delay: 0.2s">🧑‍🍳</span>
					</div>
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 md:mb-6 bg-linear-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
						PictoRecette
					</h1>
					<p class="text-xl md:text-2xl lg:text-3xl font-bold mb-3 md:mb-4">Créez des recettes accessibles avec des pictogrammes</p>
					<p class="text-base md:text-lg lg:text-xl text-base-content/80 max-w-3xl mx-auto mb-6 md:mb-8">
						Transformez la création de recettes en une expérience simple, visuelle et inclusive. 
																																																																		Générez des recettes illustrées pour faciliter la compréhension, l'apprentissage et l'autonomie.
					</p>
					<div class="flex flex-wrap gap-3 md:gap-4 justify-center">
						<a href="#features" class="btn btn-primary btn-md md:btn-lg gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
							<span class="hidden sm:inline">Découvrir les fonctionnalités</span>
							<span class="sm:hidden">Fonctionnalités</span>
						</a>
						<a href="#search-picto" class="btn btn-outline btn-md md:btn-lg gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
							</svg>
							<span class="hidden sm:inline">Rechercher des pictogrammes</span>
							<span class="sm:hidden">Rechercher</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		{# Section : Pour qui ? #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-100">
			<div class="container mx-auto px-4 max-w-7xl">
				<div class="text-center mb-8 md:mb-12">
					<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">Parfait pour</h2>
					<p class="text-base md:text-lg text-base-content/70">Des professionnels de l'éducation aux familles</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
					<div class="card bg-base-200 shadow-xl">
						<div class="card-body items-center text-center">
							<div class="text-5xl mb-3">🏫</div>
							<h3 class="card-title text-lg">IME & ULIS</h3>
							<p class="text-sm text-base-content/70">Supports pédagogiques adaptés</p>
						</div>
					</div>
					<div class="card bg-base-200 shadow-xl">
						<div class="card-body items-center text-center">
							<div class="text-5xl mb-3">💬</div>
							<h3 class="card-title text-lg">Orthophonistes</h3>
							<p class="text-sm text-base-content/70">Outils de communication alternative</p>
						</div>
					</div>
					<div class="card bg-base-200 shadow-xl">
						<div class="card-body items-center text-center">
							<div class="text-5xl mb-3">👨‍👩‍👧</div>
							<h3 class="card-title text-lg">Familles</h3>
							<p class="text-sm text-base-content/70">Autonomie au quotidien</p>
						</div>
					</div>
					<div class="card bg-base-200 shadow-xl">
						<div class="card-body items-center text-center">
							<div class="text-5xl mb-3">🎓</div>
							<h3 class="card-title text-lg">Éducateurs</h3>
							<p class="text-sm text-base-content/70">Ateliers cuisine inclusifs</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Fonctionnalités principales #}
		<section id="features" class="py-8 md:py-12 lg:py-16 bg-base-200">
			<div class="container mx-auto px-4 max-w-7xl">
				<div class="text-center mb-8 md:mb-12">
					<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">🖼️ Créer des pictogrammes n'a jamais été aussi simple</h2>
					<p class="text-base md:text-lg text-base-content/70">Un studio complet de création et gestion de pictogrammes</p>
				</div>

				<div
					class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
					{# Feature 1: ARASAAC #}
					<div class="card bg-base-100 shadow-2xl border-2 border-primary/20 hover:border-primary transition-all">
						<div class="card-body">
							<div class="text-4xl md:text-5xl mb-3 md:mb-4">🔍</div>
							<h3 class="card-title text-xl md:text-2xl mb-2 md:mb-3">Recherche ARASAAC</h3>
							<ul class="space-y-2 text-sm md:text-base">
								<li class="flex gap-2">
									<span class="text-primary">✓</span>
									Accès à des milliers de pictos gratuits</li>
								<li class="flex gap-2">
									<span class="text-primary">✓</span>
									Recherche en français ultra rapide</li>
								<li class="flex gap-2">
									<span class="text-primary">✓</span>
									Images haute définition</li>
								<li class="flex gap-2">
									<span class="text-primary">✓</span>
									Fallback intelligent</li>
							</ul>
						</div>
					</div>

					{# Feature 2: OpenFoodFacts #}
					<div class="card bg-base-100 shadow-2xl border-2 border-secondary/20 hover:border-secondary transition-all">
						<div class="card-body">
							<div class="text-4xl md:text-5xl mb-3 md:mb-4">🛒</div>
							<h3 class="card-title text-xl md:text-2xl mb-2 md:mb-3">OpenFoodFacts</h3>
							<ul class="space-y-2 text-sm md:text-base">
								<li class="flex gap-2">
									<span class="text-secondary">✓</span>
									Recherche d'ingrédients alimentaires</li>
								<li class="flex gap-2">
									<span class="text-secondary">✓</span>
									Produits avec images réelles</li>
								<li class="flex gap-2">
									<span class="text-secondary">✓</span>
									Sélection en un clic</li>
								<li class="flex gap-2">
									<span class="text-secondary">✓</span>
									Téléchargement automatique</li>
							</ul>
						</div>
					</div>

					{# Feature 3: Pictos personnalisés #}
					<div class="card bg-base-100 shadow-2xl border-2 border-accent/20 hover:border-accent transition-all">
						<div class="card-body">
							<div class="text-4xl md:text-5xl mb-3 md:mb-4">🖌️</div>
							<h3 class="card-title text-xl md:text-2xl mb-2 md:mb-3">Pictos personnalisés</h3>
							<ul class="space-y-2 text-sm md:text-base">
								<li class="flex gap-2">
									<span class="text-accent">✓</span>
									Import PNG/JPG/GIF/WebP/SVG</li>
								<li class="flex gap-2">
									<span class="text-accent">✓</span>
									Conversion automatique</li>
								<li class="flex gap-2">
									<span class="text-accent">✓</span>
									Uniformisation visuelle</li>
								<li class="flex gap-2">
									<span class="text-accent">✓</span>
									Bibliothèque personnelle</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Harmonisation automatique #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-100">
			<div class="container mx-auto px-4 max-w-6xl">
				<div class="hero bg-linear-to-br from-primary/10 to-secondary/10 rounded-3xl shadow-2xl">
					<div class="hero-content flex-col lg:flex-row gap-6 md:gap-8 py-8 md:py-12">
						<div class="lg:w-1/3 text-center">
							<div class="mockup-code ">
								<pre data-prefix=">" class="text-blue-400 text-xs md:text-sm"><code>256×256 px</code></pre>
								<pre data-prefix=">" class="text-secondary text-xs md:text-sm"><code>Fond blanc</code></pre>
								<pre data-prefix=">" class="text-accent text-xs md:text-sm"><code>Centrage parfait</code></pre>
							</div>
						</div>
						<div class="lg:w-2/3">
							<h2 class="text-2xl md:text-3xl font-bold mb-3 md:mb-4">🟦 Pictogrammes harmonisés automatiquement</h2>
							<p class="mb-3 md:mb-4 text-sm md:text-base">Chaque image — upload, ARASAAC ou OpenFoodFacts — est automatiquement :</p>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 md:gap-3">
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Téléchargée</div>
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Nettoyée</div>
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Convertie en PNG HD</div>
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Redimensionnée 256×256</div>
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Fond blanc uniforme</div>
								<div class="flex items-center gap-2">
									<span class="text-primary text-xl">✔</span>
									Miniature 70×70</div>
							</div>
							<div class="alert alert-success mt-3 md:mt-4 text-sm md:text-base">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
								<span>Résultat : bibliothèque propre, cohérente et professionnelle</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Construction de recettes #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-200">
			<div class="container mx-auto px-4 max-w-7xl">
				<div class="text-center mb-8 md:mb-12">
					<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">🧩 Construisez vos recettes en pictogrammes</h2>
					<p class="text-base md:text-lg text-base-content/70">Interface claire et intuitive</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<h3 class="card-title text-lg md:text-xl">📝 Création simple</h3>
							<ul class="space-y-2 text-sm md:text-base">
								<li>→ Sélectionnez vos ingrédients en pictos</li>
								<li>→ Ajoutez les étapes (texte + pictos)</li>
								<li>→ Organisez les ustensiles</li>
								<li>→ Générez une fiche lisible</li>
							</ul>
						</div>
					</div>
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<h3 class="card-title text-lg md:text-xl">👥 Pour tous</h3>
							<ul class="space-y-2 text-sm md:text-base">
								<li>✓ Compatible enfants</li>
								<li>✓ Personnes non lectrices</li>
								<li>✓ Apprentissage TSA</li>
								<li>✓ Apprentissage visuel</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Export PDF #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-100">
			<div class="container mx-auto px-4 max-w-5xl">
				<div class="card bg-linear-to-br from-accent/10 to-primary/10 shadow-2xl">
					<div class="card-body items-center text-center p-6 md:p-12">
						<div class="text-5xl md:text-6xl mb-4 md:mb-6">📄</div>
						<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">Génération PDF ultra propre</h2>
						<p class="text-base md:text-lg mb-4 md:mb-6 max-w-2xl">
							Grâce à l'intégration de
							<span class="font-bold">Browsershot + Puppeteer</span>
							dans Docker
						</p>
						<div class="stats stats-vertical lg:stats-horizontal shadow w-full max-w-3xl">
							<div class="stat">
								<div class="stat-title">Qualité</div>
								<div class="stat-value text-primary">HD</div>
								<div class="stat-desc">Export haute qualité</div>
							</div>
							<div class="stat">
								<div class="stat-title">Mise en page</div>
								<div class="stat-value text-secondary">Stable</div>
								<div class="stat-desc">Rendu parfait</div>
							</div>
							<div class="stat">
								<div class="stat-title">Usage</div>
								<div class="stat-value text-accent">Print</div>
								<div class="stat-desc">Prêt impression</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Impact #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-200">
			<div class="container mx-auto px-4 max-w-5xl">
				<div class="hero bg-linear-to-br from-success/20 to-info/20 rounded-3xl shadow-2xl">
					<div class="hero-content text-center py-10 md:py-16">
						<div>
							<div class="text-5xl md:text-6xl mb-4 md:mb-6">🚀</div>
							<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 md:mb-6">PictoRecette rend la cuisine accessible à tous</h2>
							<p class="text-base md:text-lg mb-6 md:mb-8 max-w-3xl">
								Créez des recettes visuelles, structurées et intuitives pour favoriser l'apprentissage, 
																																																																																								l'autonomie et l'inclusion.
							</p>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4 max-w-2xl mx-auto text-left text-sm md:text-base">
								<div>✓ Apprendre à cuisiner</div>
								<div>✓ Travailler l'autonomie</div>
								<div>✓ Favoriser la compréhension</div>
								<div>✓ Structurer le langage</div>
								<div>✓ Aider les enfants</div>
								<div>✓ Soutenir personnes TSA, T21</div>
								<div>✓ Difficulté de lecture</div>
								<div>✓ Simplifier le quotidien</div>
							</div>
							<div class="mt-6 md:mt-8">
								<p class="text-lg md:text-xl font-semibold italic">La cuisine expliquée avec des images</p>
								<p class="text-sm md:text-base text-base-content/70">Pensée pour l'inclusion, la pédagogie et l'autonomie</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# Section : Avantages #}
		<section class="py-8 md:py-12 lg:py-16 bg-base-100">
			<div class="container mx-auto px-4 max-w-7xl">
				<div class="text-center mb-8 md:mb-12">
					<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">⏱️ Rapide, intuitif, accessible</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
					<div class="card bg-linear-to-br from-primary/20 to-primary/5 shadow-xl border border-primary/20">
						<div class="card-body">
							<h3 class="card-title text-primary">🚀 Performance</h3>
							<ul class="space-y-1 text-sm">
								<li>• Temps réel</li>
								<li>• Recherche prédictive</li>
								<li>• Navigation fluide</li>
								<li>• Optimisé tablettes</li>
							</ul>
						</div>
					</div>
					<div class="card bg-linear-to-br from-secondary/20 to-secondary/5 shadow-xl border border-secondary/20">
						<div class="card-body">
							<h3 class="card-title text-secondary">🎯 Fiabilité</h3>
							<ul class="space-y-1 text-sm">
								<li>• Aucun 404</li>
								<li>• Fallback intelligent</li>
								<li>• Services testables</li>
								<li>• Architecture découplée</li>
							</ul>
						</div>
					</div>
					<div class="card bg-linear-to-br from-accent/20 to-accent/5 shadow-xl border border-accent/20">
						<div class="card-body">
							<h3 class="card-title text-accent">🌐 Accessibilité</h3>
							<ul class="space-y-1 text-sm">
								<li>• Mode sombre/clair</li>
								<li>• Adaptable</li>
								<li>• Utilisable en local</li>
								<li>• Raspberry Pi ready</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>


	</div>
{% endblock %}
