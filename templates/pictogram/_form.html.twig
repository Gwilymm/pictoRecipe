{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

{# Champ nom du pictogramme - séparé de la recherche #}
<div class="form-control">
	<label class="label">
		<span class="label-text font-semibold">Nom du pictogramme</span>
	</label>
	{{ form_widget(form.name, {
		'attr': {
			'placeholder': 'Ex : Farine, Maïzena, Beurre doux…',
			'class':'input input-bordered w-full' ~ (form.name.vars.errors|length > 0 ? ' input-error' : '')
		}
	}) }}

	{# Affichage des erreurs du champ name #}
	{% if form.name.vars.errors|length > 0 %}
		<div class="text-error text-sm mt-1 flex items-center gap-1">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
			</svg>
			{% for error in form.name.vars.errors %}
				<p>{{ error.message }}</p>
			{% endfor %}
		</div>
	{% endif %}
</div>

{# Section recherche d'image OpenFoodFacts - indépendante #}
<div class="form-control" data-controller="picto-search">
	<label class="label">
		<span class="label-text font-semibold flex items-center gap-2">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
			</svg>
			Rechercher une image
		</span>
	</label>

	<div
		class="space-y-3"
	>
		{# Champ de recherche d'ingrédient #}
		<input
			type="text"
			data-picto-search-target="input"
			placeholder="Rechercher un ingrédient : farine, beurre, œufs…"
			class="input input-bordered w-full"
		/>
		<div class="form-control">
			{{ form_row(form.imageFile, {
		'label_attr': {'class': 'label'},
		'row_attr': {'class': 'w-full'}
	}) }}
		</div>

		<div class="flex flex-wrap gap-2" data-picto-search-target="filters" aria-label="Filtrer les sources">
			<button type="button" class="btn btn-xs btn-primary" data-source="openfoodfacts" data-action="click->picto-search#toggleSource">OpenFoodFacts</button>
			<button type="button" class="btn btn-xs btn-primary" data-source="arasaac" data-action="click->picto-search#toggleSource">ARASAAC</button>
			<button type="button" class="btn btn-xs btn-primary" data-source="wikimedia" data-action="click->picto-search#toggleSource">Wikimedia</button>
			<button type="button" class="btn btn-xs btn-primary" data-source="local" data-action="click->picto-search#toggleSource">Local</button>
		</div>

		{# Champ optionnel pour filtrer par marque #}
		<div class="w-full">
			<label class="label pt-0">
				<span class="label-text text-sm flex items-center gap-1">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
					</svg>
					Filtrer par marque (optionnel)
				</span>
			</label>
			<input type="text" data-picto-search-target="brandInput" placeholder="Ex : Carrefour, Tipiak, Barilla…" class="input input-bordered w-full"/>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 items-start">
			<div data-picto-search-target="results" class="grid grid-cols-3 gap-2 pr-1 content-start w-full sm:w-2/3" style="height:28rem; overflow-y:auto; overflow-x:hidden"></div>
			<aside data-picto-search-target="preview" class="rounded-2xl bg-base-200 p-4 text-base-content shadow-sm w-full sm:w-1/3 sm:sticky sm:top-4">
				<div class="flex items-center justify-between mb-3">
					<p class="text-sm font-semibold">Aperçu PDF</p>
					<span class="badge badge-ghost badge-sm">glisser pour déplacer</span>
				</div>
				<div data-picto-search-target="previewViewport" data-action="pointerdown->picto-search#startPreviewDrag pointermove->picto-search#previewDrag pointerup->picto-search#endPreviewDrag pointercancel->picto-search#endPreviewDrag" class="mx-auto flex items-center justify-center overflow-hidden border-2 border-dashed border-base-300 rounded-lg touch-none select-none" style="width:220px;height:220px;background:#f3f4f6" title="Cadre de taille du pictogramme dans le PDF">
					<span data-picto-search-target="previewPlaceholder" class="text-xs text-slate-400 text-center px-5">Sélectionne un pictogramme</span>
					<img data-picto-search-target="previewImage" class="hidden object-contain transition-transform duration-150" style="height:208px;width:100%;object-fit:contain" alt="Pictogramme sélectionné">
				</div>
				<label class="label px-0 mt-3"><span class="label-text">Taille <span data-picto-search-target="zoomValue">100 %</span></span></label>
				<input type="range" min="0.5" max="2" step="0.05" value="1" data-picto-search-target="zoom" data-action="input->picto-search#changePreviewSize" class="range range-primary range-sm">
				<label class="label px-0 mt-2"><span class="label-text">Fond gris <span data-picto-search-target="backgroundValue">8 %</span></span></label>
				<input type="range" min="0" max="35" step="1" value="8" data-picto-search-target="background" data-action="input->picto-search#changePreviewBackground" class="range range-primary range-sm">
				<button type="button" class="btn btn-ghost btn-xs mt-2" data-action="click->picto-search#resetPreview">Réinitialiser la position et la taille</button>
			</aside>
		</div>
		<div data-picto-search-target="pagination" class="hidden"></div>
	</div>
</div>



{# 🔥 LE SEUL CHAMP ACCEPTABLE #}
<input type="hidden" id="externalImageTemp" name="externalImageTemp"/>



<button class="btn btn-primary mt-6 w-full sm:w-auto">
	<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
	</svg>
	Enregistrer
</button>

{{ form_end(form) }}


{# =============================================================== #}
{# Script minimal : écoute la sélection picto:selected (via Stimulus) #}
{# =============================================================== #}

<script>
	document.addEventListener("picto:selected", (e) => {
		const item = e.detail;
		const hidden =
			document.getElementById(
				"{{ form.vars.full_name }}_externalImageUrl",
			) || document.getElementById("externalImageTemp");
		const preview = document.getElementById("picto-external-preview");

		if (hidden) {
			hidden.value = item.image;
		}

		if (preview) {
			preview.innerHTML = `
            <img src="${item.image}"
                 class="w-24 h-24 object-contain rounded-lg shadow">
            <div class="mt-1 text-sm opacity-75">${item.name || ""}</div>
        `;
		}
	});
</script>
