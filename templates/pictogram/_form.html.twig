{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div class="form-control">
	<label class="label">
		<span class="label-text font-semibold">Nom du pictogramme</span>
	</label>

	<div data-controller="picto-search" class="space-y-3">
		{{ form_widget(form.name, {
            'attr': {
                'data-picto-search-target': 'input',
                'placeholder': 'Ex : farine, maïzena…',
                'class':'input input-bordered w-full'
            }
        }) }}

		<div data-picto-search-target="results" class="grid grid-cols-3 sm:grid-cols-4 gap-3"></div>
	</div>
</div>

<div class="form-control">
	<label class="label">
		<span class="label-text font-semibold">Image (PNG ou SVG)</span>
	</label>

	{{ form_row(form.imageFile) }}
</div>

{# 🔥 LE SEUL CHAMP ACCEPTABLE #}
<input type="hidden" id="externalImageTemp" name="externalImageTemp"/>

<div id="picto-external-preview" class="mt-4"></div>

<button class="btn btn-primary mt-6 w-full sm:w-auto">💾 Enregistrer</button>

{{ form_end(form) }}


{# =============================================================== #}
{# Script minimal : écoute la sélection picto:selected (via Stimulus) #}
{# =============================================================== #}

	<script>
document.addEventListener( "picto:selected", ( e ) => {





const item = e.detail;
const hidden = document.getElementById( "{{ form.vars.full_name }}_externalImageUrl" );
const preview = document.getElementById( "picto-external-preview" );

if ( hidden )
{





hidden.value = item.image;





}

if ( preview )
{





preview.innerHTML = `
            <img src="${
item.image
}"
                 class="w-24 h-24 object-contain rounded-lg shadow">
            <div class="mt-1 text-sm opacity-75">${
item.name || ''
}</div>
        `;





}

} );</script>
