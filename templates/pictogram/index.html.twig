{% extends 'base.html.twig' %}

{% block title %}Pictogrammes{% endblock %}

{% block body %}
	{% import '_ds/_ui.html.twig' as ui %}
	<div class="space-y-6" data-controller="pictogram-filter">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<h1 class="text-2xl">Pictogrammes</h1>
			<a href="{{ path('app_pictogram_new') }}" class="btn btn-primary">
				{{ ux_icon('lucide:plus', { class: 'size-5', 'aria-hidden': 'true' }) }}
				Ajouter un pictogramme
			</a>
		</div>

		{% if pictograms is empty %}
			{{ ui.empty_state('Aucun pictogramme pour l’instant.') }}
		{% else %}
			{{ ui.filter_search('pictogram-filter', 'pictogrammes', pictograms|length) }}

			<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8" data-pictogram-filter-target="grid">
				{% for pictogram in pictograms %}
					<li class="flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-3 text-center"
						data-pictogram-filter-target="card"
						data-name="{{ pictogram.name|lower }}"
						data-format="{{ pictogram.format|lower }}"
						data-source="{{ pictogram.source|lower }}">
						<div class="picto-tile w-full">
							<img src="{{ asset(pictogram.filePath) }}" alt="" loading="lazy">
						</div>
						<div class="space-y-1">
							<h2 class="line-clamp-2 text-sm font-bold leading-tight">{{ pictogram.name }}</h2>
							<p class="text-xs text-muted">{{ pictogram.format|upper }} · {{ pictogram.sourceDisplayName }}</p>
							{% if not pictogram.validated %}
								<p class="text-sm font-bold text-error">À valider</p>
							{% endif %}
						</div>

						<div class="mt-auto flex justify-center gap-2">
							{% if not pictogram.validated %}
								<form method="post" action="{{ path('app_pictogram_validate', {id: pictogram.id}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('validate' ~ pictogram.id) }}">
									<button type="submit" class="btn btn-sm btn-outline btn-primary btn-square" aria-label="Valider {{ pictogram.name }}">
										{{ ux_icon('lucide:check', { class: 'size-5', 'aria-hidden': 'true' }) }}
									</button>
								</form>
							{% endif %}
							<a href="{{ path('app_pictogram_edit', {id: pictogram.id}) }}" class="btn btn-sm btn-outline btn-square" aria-label="Modifier {{ pictogram.name }}">
								{{ ux_icon('lucide:pencil', { class: 'size-5', 'aria-hidden': 'true' }) }}
							</a>
							{{ ui.delete_button(path('app_pictogram_delete', {id: pictogram.id}), csrf_token('delete' ~ pictogram.id), pictogram.name, 'le pictogramme', 'btn-sm', true) }}
						</div>
					</li>
				{% endfor %}
			</ul>

			{{ ui.filter_footer('pictogram-filter', 'pictogramme') }}
		{% endif %}
	</div>
{% endblock %}
