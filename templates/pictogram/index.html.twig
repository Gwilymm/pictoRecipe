{% extends 'base.html.twig' %}

{% block title %}Pictogrammes personnalisés
{% endblock %}

{% block body %}
	<h1 class="text-3xl font-bold mb-6">Galerie des pictogrammes</h1>

	<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">
		{% for pictogram in pictograms %}
			<div class="card bg-base-100 shadow-md w-full">
				<figure><img src="{{ asset(pictogram.filePath) }}" alt="{{ pictogram.name }}" class="w-24 h-24 object-contain mx-auto"></figure>
				<div class="card-body p-2 text-center">
					<h3 class="text-sm font-semibold">{{ pictogram.name }}</h3>
					<p class="text-xs text-gray-500">{{ pictogram.format|upper }}</p>
					<div class="card-actions justify-center mt-2">
						<a href="{{ path('app_pictogram_edit', {'id': pictogram.id}) }}" class="btn btn-xs btn-warning">Modifier</a>
						<button onclick="document.getElementById('delete-modal-{{ pictogram.id }}').showModal()" class="btn btn-xs btn-error">Supprimer</button>
					</div>
				</div>
			</div>

			<!-- Delete Modal -->
			<dialog id="delete-modal-{{ pictogram.id }}" class="modal">
				<div class="modal-box">
					<h3 class="font-bold text-lg">Confirmer la suppression</h3>
					<p class="py-4">Êtes-vous sûr de vouloir supprimer le pictogramme "{{ pictogram.name }}" ?</p>
					<div class="modal-action">
						<form method="post" action="{{ path('app_pictogram_delete', {'id': pictogram.id}) }}" style="display: inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pictogram.id) }}">
							<button type="submit" class="btn btn-error">Supprimer</button>
						</form>
						<button onclick="document.getElementById('delete-modal-{{ pictogram.id }}').close()" class="btn">Annuler</button>
					</div>
				</div>
			</dialog>
		{% else %}
			<div class="col-span-full text-center py-8">
				<p class="text-gray-500">Aucun pictogramme trouvé</p>
			</div>
		{% endfor %}
	</div>

	<a href="{{ path('app_pictogram_new') }}" class="btn btn-primary">Ajouter un pictogramme</a>
{% endblock %}
