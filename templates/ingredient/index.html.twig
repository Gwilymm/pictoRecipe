{% extends 'base.html.twig' %}

{% block title %}Ingredient index
{% endblock %}

{% block body %}
	<h1 class="text-3xl font-bold mb-6">Liste des ingrédients</h1>

	<div class="overflow-x-auto">
		<table class="table table-zebra w-full">
			<thead>
				<tr>
					<th>Id</th>
					<th>Nom</th>
					<th>Quantité</th>
					<th>Unité</th>
					<th>Position</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for ingredient in ingredients %}
					<tr>
						<td>{{ ingredient.id }}</td>
						<td>{{ ingredient.name }}</td>
						<td>{{ ingredient.amount }}</td>
						<td>{{ ingredient.unit }}</td>
						<td>{{ ingredient.position }}</td>
						<td class="space-x-2">
							<a href="{{ path('app_ingredient_show', {'id': ingredient.id}) }}" class="btn btn-sm btn-info">Voir</a>
							<a href="{{ path('app_ingredient_edit', {'id': ingredient.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="6" class="text-center">Aucun ingrédient trouvé</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<a href="{{ path('app_ingredient_new') }}" class="btn btn-success mt-6">Ajouter un ingrédient</a>
{% endblock %}
