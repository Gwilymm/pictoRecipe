<form method="post" action="{{ path('app_ingredient_delete', {'id': ingredient.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet ingrédient ?');" class="inline">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ingredient.id) }}">
	<button class="btn btn-error">Supprimer</button>
</form>
