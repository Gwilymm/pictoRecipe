{% extends 'base.html.twig' %}

{% block title %}Ingredient
{% endblock %}

{% block body %}
	<h1 class="text-3xl font-bold mb-6">Détail de l'ingrédient</h1>

	<div class="overflow-x-auto mb-6">
		<table class="table table-zebra w-full">
			<tbody>
				<tr>
					<th>Id</th>
					<td>{{ ingredient.id }}</td>
				</tr>
				<tr>
					<th>Nom</th>
					<td>{{ ingredient.name }}</td>
				</tr>
				<tr>
					<th>Quantité</th>
					<td>{{ ingredient.amount }}</td>
				</tr>
				<tr>
					<th>Unité</th>
					<td>{{ ingredient.unit }}</td>
				</tr>
				<tr>
					<th>Position</th>
					<td>{{ ingredient.position }}</td>
				</tr>
			</tbody>
		</table>
	</div>

	<div class="space-x-2">
		<a href="{{ path('app_ingredient_index') }}" class="btn btn-outline">Retour à la liste</a>
		<a href="{{ path('app_ingredient_edit', {'id': ingredient.id}) }}" class="btn btn-warning">Modifier</a>
	</div>

	<div class="mt-4">
		{{ include('ingredient/_delete_form.html.twig') }}
	</div>
{% endblock %}
