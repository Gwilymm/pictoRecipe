{#
  Widget pour sélectionner PLUSIEURS pictogrammes
  Utilisé pour les étapes qui peuvent avoir plusieurs pictos (ex: mélanger + beurre + sucre)
  
  Paramètres attendus:
  - form_field : Le champ de formulaire pour déclencher la recherche
  - urls_field : Le champ hidden qui contiendra les URLs en JSON
  - placeholder : Texte du placeholder de recherche
#}

<div
	data-controller="pictogram" data-pictogram-mode="multiple" data-pictogram-target-value="{{ urls_field.vars.id }}">
	{# Champ hidden pour stocker les URLs en JSON #}
	{{ form_widget(urls_field) }}

	{# Zone d'affichage des pictogrammes sélectionnés #}
	<div
		class="flex flex-wrap gap-2 mb-3 min-h-12 p-2 border border-dashed border-base-300 rounded-lg" data-pictogram-target="selectedContainer">
		{# Les pictogrammes sélectionnés apparaîtront ici #}
		<span class="text-xs text-base-content/50 self-center" data-pictogram-target="emptyMessage">Aucun pictogramme sélectionné</span>
	</div>

	{# Zone de recherche (collapsible) #}
	<div class="collapse collapse-arrow bg-base-200" data-pictogram-target="searchZone">
		<input type="checkbox" class="peer" data-pictogram-target="searchToggle"/>
		<div class="collapse-title text-sm font-medium">
			🔍 Ajouter des pictogrammes
		</div>
		<div
			class="collapse-content">
			{# Champ de recherche compact #}
			<div class="relative">
				<input type="text" class="input input-bordered input-sm w-full max-w-md pr-10" placeholder="{{ placeholder|default('Rechercher...') }}" data-pictogram-target="search" data-action="input->pictogram#onSearchInput"/>
				<span class="absolute right-3 top-2 text-sm">🔍</span>
			</div>

			{# Résultats de recherche #}
			<div class="mt-2 hidden" data-pictogram-target="results">
				<div class="card bg-base-100 shadow-lg max-h-64 overflow-y-auto">
					<div class="card-body p-2">
						<div
							class="grid grid-cols-4 gap-2" data-pictogram-target="resultsList">{# Les résultats apparaîtront ici via JavaScript #}
						</div>
					</div>
				</div>
			</div>

			{# Bouton pour fermer la recherche #}
			<div class="mt-3 flex justify-end">
				<button type="button" class="btn btn-sm btn-outline" data-action="click->pictogram#closeSearch">
					✓ Terminé
				</button>
			</div>

			{# Message d'info #}
			<div class="text-xs text-base-content/60 mt-2">
				💡 Conseil : Recherchez et ajoutez plusieurs pictogrammes pour illustrer cette étape (ex: mélanger + beurre + sucre)
			</div>
		</div>
	</div>
</div>
