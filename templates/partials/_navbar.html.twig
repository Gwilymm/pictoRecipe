{% set route = app.request.attributes.get('_route') ?? '' %}
{% set links = [
	{ label: 'Recettes',     path: path('app_recipe_index'),    active: route starts with 'app_recipe' },
	{ label: 'Ustensiles',   path: path('app_utensil_index'),   active: route starts with 'app_utensil' },
	{ label: 'Pictogrammes', path: path('app_pictogram_index'), active: route starts with 'app_pictogram' },
] %}

<header class="shrink-0 border-b border-base-300 bg-base-100">
	<nav aria-label="Navigation principale" class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-7 gap-y-3 px-4 py-3">
		<a href="{{ path('app_home') }}" class="flex items-center gap-2.5 font-display text-xl font-bold no-underline">
			<span aria-hidden="true" class="grid size-9 grid-cols-2 gap-[3px] rounded-[9px] bg-primary p-[7px]">
				<span class="rounded-[3px] bg-white"></span><span class="rounded-[3px] bg-accent"></span>
				<span class="rounded-[3px] bg-accent"></span><span class="rounded-[3px] bg-white"></span>
			</span>
			PictoRecette
		</a>

		<ul class="flex flex-1 flex-wrap gap-1">
			{% for link in links %}
				<li>
					<a href="{{ link.path }}"
					   {% if link.active %}aria-current="page"{% endif %}
					   class="inline-flex min-h-11 items-center rounded-[10px] px-3.5 font-bold no-underline
					          {{ link.active ? 'bg-step-soft shadow-[inset_0_-3px_0_var(--color-primary)]' : 'hover:bg-base-200' }}">
						{{ link.label }}
					</a>
				</li>
			{% endfor %}
		</ul>

		<button type="button" class="btn btn-ghost btn-square" aria-pressed="false"
		        data-controller="theme" data-theme-target="button" data-action="theme#toggle">
			{{ ux_icon('lucide:moon', { class: 'size-6', 'aria-hidden': 'true' }) }}
			<span class="sr-only" data-theme-target="label">Thème sombre</span>
		</button>

		<a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
			{{ ux_icon('lucide:plus', { class: 'size-5', 'aria-hidden': 'true' }) }}
			Créer une recette
		</a>
	</nav>
</header>
