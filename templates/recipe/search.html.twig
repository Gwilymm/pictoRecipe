{% extends 'base.html.twig' %}

{% block title %}Rechercher des recettes
{% endblock %}

{% block body %}
	<div class="container mx-auto px-3 md:px-4 py-4 md:py-8" data-controller="recipe-search sort">
		<h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-center mb-4 md:mb-8">🔍 Rechercher des recettes (Marmiton &amp; Cuisine AZ)</h1>

		{# Formulaire de recherche #}
		<div class="card bg-base-100 p-3 md:p-6 rounded-xl shadow-md w-full max-w-2xl mx-auto mt-3 md:mt-6">
			<form
				method="post" action="#" data-recipe-search-target="form" data-action="submit->recipe-search#search">
				{# Mot-clé #}
				<div class="form-control mb-3 md:mb-4">
					<label class="label">
						<span class="label-text  text-sm md:text-base">Mot-clé</span>
					</label>
					<input type="text" name="query" placeholder="Ex: poulet, tarte, soupe..." class="input input-md input-bordered w-full" data-recipe-search-target="query">
				</div>

				<fieldset class="mb-4">
					<legend class="mb-2 font-bold">Options alimentaires</legend>
					<div class="flex flex-wrap gap-2">
						<label class="chip"><input type="checkbox" name="vegan" class="sr-only" data-recipe-search-target="vegan">Vegan</label>
						<label class="chip"><input type="checkbox" name="vegetarian" class="sr-only" data-recipe-search-target="vegetarian">Végétarien</label>
						<label class="chip"><input type="checkbox" name="withoutGluten" class="sr-only" data-recipe-search-target="withoutGluten">Sans gluten</label>
						<label class="chip"><input type="checkbox" name="withoutDairyProducts" class="sr-only" data-recipe-search-target="withoutDairyProducts">Sans produits laitiers</label>
					</div>
				</fieldset>

				<fieldset class="mb-4">
					<legend class="mb-2 font-bold">Options de cuisson</legend>
					<div class="flex flex-wrap gap-2">
						<label class="chip"><input type="checkbox" name="withoutOven" class="sr-only" data-recipe-search-target="withoutOven">Sans four</label>
						<label class="chip"><input type="checkbox" name="raw" class="sr-only" data-recipe-search-target="raw">Cru (sans cuisson)</label>
					</div>
				</fieldset>

				{# Bouton de recherche #}
				<button type="submit" class="btn btn-primary w-full mt-2 md:mt-0" data-recipe-search-target="submitBtn">
					<span data-recipe-search-target="submitText" class="inline-flex items-center gap-2">{{ ux_icon('lucide:search', { class: 'size-5', 'aria-hidden': 'true' }) }}Rechercher</span>
					<span class="loading loading-spinner loading-sm hidden" data-recipe-search-target="spinner"></span>
				</button>
			</form>
		</div>

		{# Message d'information initial #}
		<div class="alert alert-info w-full max-w-2xl mx-auto mt-3 md:mt-6 text-xs md:text-sm" data-recipe-search-target="infoMessage">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5 md:w-6 md:h-6">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<span>Remplissez au moins un critère de recherche pour découvrir des recettes.</span>
		</div>

		{# Message d'erreur (caché par défaut) #}
		<div class="alert alert-error w-full max-w-2xl mx-auto mt-3 md:mt-6 text-xs md:text-sm hidden" data-recipe-search-target="errorMessage">
			<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5 md:h-6 md:w-6" fill="none" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
			</svg>
			<span data-recipe-search-target="errorText">Une erreur est survenue.</span>
		</div>

		{# Conteneur des résultats #}
		<div class="flex items-center justify-between w-full max-w-6xl mx-auto mt-4 md:mt-6">
			<div class="text-sm text-gray-600" data-recipe-search-target="count">&nbsp;</div>
			<div id="search-pagination" data-recipe-search-target="pagination"></div>
		</div>

		{# Tri des résultats - Stimulus sort controller #}
		<div class="flex items-center gap-2 my-3 max-w-6xl mx-auto w-full">
			<label class="font-medium">Trier par :</label>
			<select data-sort-target="select" class="select select-bordered select-sm">
				<option value="best">🥇 Pertinence</option>
				<option value="rating">⭐ Note</option>
				<option value="name">🔤 Alphabetique</option>
				<option value="source">🌐 Source</option>
			</select>
		</div>

		<div id="results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 mt-4 md:mt-8 w-full max-w-6xl mx-auto" data-recipe-search-target="results" data-sort-target="results"></div>
	</div>
{% endblock %}
