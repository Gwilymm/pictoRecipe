{% extends 'base.html.twig' %}

{% block title %}Rechercher des recettes
{% endblock %}

{% block body %}
	<div class="space-y-6" data-controller="recipe-search sort">
		<div class="space-y-2">
			<h1 class="text-2xl">Rechercher des recettes</h1>
			<p class="text-muted">Sur Marmiton, Cuisine AZ et Papilles &amp; Pupilles.</p>
		</div>

		{# Formulaire de recherche #}
		<div class="max-w-2xl rounded-box border border-base-300 bg-base-100 p-5 sm:p-6">
			<form
				method="post" action="#" data-recipe-search-target="form" data-action="submit->recipe-search#search">
				{# Mot-clé #}
				<div class="form-control mb-3 md:mb-4">
					<label for="recipe-search-query" class="mb-2 block font-bold">Mot-clé</label>
					<input id="recipe-search-query" type="search" name="query" placeholder="Ex: poulet, tarte, soupe..." class="input input-md input-bordered w-full" data-recipe-search-target="query">
				</div>

				<fieldset class="mb-4">
					<legend class="mb-2 font-bold">Options alimentaires</legend>
					<div class="flex flex-wrap gap-2">
						<label class="chip"><input type="checkbox" name="vegan" class="sr-only" data-recipe-search-target="vegan">Vegan</label>
						<label class="chip"><input type="checkbox" name="vegetarian" class="sr-only" data-recipe-search-target="vegetarian">Végétarien</label>
						<label class="chip"><input type="checkbox" name="withoutGluten" class="sr-only" data-recipe-search-target="withoutGluten">Sans gluten</label>
						<label class="chip"><input type="checkbox" name="withoutDairyProducts" class="sr-only" data-recipe-search-target="withoutDairyProducts">Sans produits laitiers</label>
					</div>
				</fieldset>

				<fieldset class="mb-4">
					<legend class="mb-2 font-bold">Options de cuisson</legend>
					<div class="flex flex-wrap gap-2">
						<label class="chip"><input type="checkbox" name="withoutOven" class="sr-only" data-recipe-search-target="withoutOven">Sans four</label>
						<label class="chip"><input type="checkbox" name="raw" class="sr-only" data-recipe-search-target="raw">Cru (sans cuisson)</label>
					</div>
				</fieldset>

				{# Bouton de recherche #}
				<button type="submit" class="btn btn-primary w-full mt-2 md:mt-0" data-recipe-search-target="submitBtn">
					<span data-recipe-search-target="submitText" class="inline-flex items-center gap-2">{{ ux_icon('lucide:search', { class: 'size-5', 'aria-hidden': 'true' }) }}Rechercher</span>
					<span class="loading loading-spinner loading-sm hidden" data-recipe-search-target="spinner"></span>
				</button>
			</form>
		</div>

		{# Message d'information initial #}
		<div class="max-w-2xl text-muted" data-recipe-search-target="infoMessage">
			<span>Remplissez au moins un critère de recherche pour découvrir des recettes.</span>
		</div>

		{# Message d'erreur (caché par défaut) #}
		<div class="hidden max-w-2xl rounded-box bg-danger-soft p-4 font-bold" role="alert" data-recipe-search-target="errorMessage">
			<span data-recipe-search-target="errorText">Une erreur est survenue.</span>
		</div>

		{# Conteneur des résultats #}
		<div class="flex flex-wrap items-center justify-between gap-3">
			<p class="text-muted" data-recipe-search-target="count" aria-live="polite"></p>
			<div id="search-pagination" data-recipe-search-target="pagination"></div>
		</div>

		{# Tri des résultats - Stimulus sort controller #}
		<div class="flex items-center gap-3">
			<label for="recipe-search-sort" class="font-bold">Trier par</label>
			<select id="recipe-search-sort" data-sort-target="select" class="select w-auto">
				<option value="best">Pertinence</option>
				<option value="rating">Note</option>
				<option value="name">Ordre alphabétique</option>
				<option value="source">Site</option>
			</select>
		</div>

		<div id="results" class="grid gap-4 sm:grid-cols-3 lg:grid-cols-4" data-recipe-search-target="results" data-sort-target="results"></div>
	</div>
{% endblock %}
