{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
	{% import '_ds/_ui.html.twig' as ui %}
	<div class="space-y-6" data-controller="modal">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<h1 class="text-2xl">Recettes</h1>
			<div class="flex flex-wrap items-center gap-3">
				<form method="get" action="{{ path('app_recipe_index') }}" role="search" class="join">
					<label for="recipe-q" class="sr-only">Rechercher une recette</label>
					<input id="recipe-q" type="search" name="q" value="{{ q|default('') }}" placeholder="Rechercher une recette…" class="input join-item w-56"/>
					<button type="submit" class="btn btn-outline join-item" aria-label="Rechercher">
						{{ ux_icon('lucide:search', { class: 'size-5', 'aria-hidden': 'true' }) }}
					</button>
				</form>
				<a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
					{{ ux_icon('lucide:plus', { class: 'size-5', 'aria-hidden': 'true' }) }}
					Ajouter une recette
				</a>
			</div>
		</div>

		{% include 'partials/_dialog_modal.html.twig' with {
			id: 'delete-modal',
			title: 'Supprimer la recette',
			message: 'Voulez-vous vraiment supprimer la recette ',
			confirm_label: 'Supprimer',
			cancel_label: 'Annuler',
			method: 'post'
		} %}

		{% if recipes is empty %}
			{{ ui.empty_state(q|default('') ? 'Aucune recette ne correspond à « ' ~ q ~ ' ».' : 'Aucune recette pour l’instant.') }}
		{% else %}
			<ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-4">
				{% for recipe in recipes %}
					{% set src = ui.recipe_image_src(recipe)|trim %}
					{% set total = (recipe.prepTimeMinutes ?? 0) + (recipe.cookTimeMinutes ?? 0) %}
					<li class="flex flex-col overflow-hidden rounded-box border border-base-300 bg-base-100">
						<div class="relative aspect-[4/3] overflow-hidden bg-step-soft">
							{% if src %}
								<img src="{{ src }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" style="{{ ui.recipe_image_style(recipe) }}">
							{% else %}
								<div class="grid h-full place-items-center text-primary" aria-hidden="true">
									{{ ux_icon('lucide:image', { class: 'size-10' }) }}
								</div>
							{% endif %}
						</div>

						<div class="flex flex-1 flex-col gap-2 p-4">
							<h2 class="text-base leading-snug">
								<a href="{{ path('app_recipe_show', {id: recipe.id}) }}" class="link link-hover">{{ recipe.title }}</a>
							</h2>
							{% if recipe.description %}
								<p class="line-clamp-2 text-sm text-muted">{{ recipe.description }}</p>
							{% endif %}
							{% if recipe.servings or total %}
								<ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
									{% if recipe.servings %}
										<li class="inline-flex items-center gap-1.5">
											{{ ux_icon('lucide:users', { class: 'size-4 text-secondary', 'aria-hidden': 'true' }) }}
											{{ recipe.servings }} part{{ recipe.servings > 1 ? 's' : '' }}
										</li>
									{% endif %}
									{% if total %}
										<li class="inline-flex items-center gap-1.5">
											{{ ux_icon('lucide:clock', { class: 'size-4 text-secondary', 'aria-hidden': 'true' }) }}
											{{ total }} min
										</li>
									{% endif %}
								</ul>
							{% endif %}

							<div class="mt-auto flex gap-2 pt-1">
								<a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-outline flex-1">
									{{ ux_icon('lucide:pencil', { class: 'size-5', 'aria-hidden': 'true' }) }}
									Modifier
								</a>
								<button type="button" class="btn btn-sm btn-outline btn-error btn-square"
									aria-label="Supprimer {{ recipe.title }}"
									data-action="modal#open"
									data-modal-action="{{ path('app_recipe_delete', {id: recipe.id}) }}"
									data-modal-token="{{ csrf_token('delete' ~ recipe.id) }}"
									data-modal-name="{{ recipe.title }}">
									{{ ux_icon('lucide:trash-2', { class: 'size-5', 'aria-hidden': 'true' }) }}
								</button>
							</div>
						</div>
					</li>
				{% endfor %}
			</ul>

			{% if totalPages is defined and totalPages > 1 %}
				<nav class="flex justify-center" aria-label="Pagination">
					<div class="join">
						{% if page > 1 %}
							<a href="{{ path('app_recipe_index', {page: page - 1, q: q|default('')}) }}" class="btn join-item" aria-label="Page précédente">
								{{ ux_icon('lucide:chevron-left', { class: 'size-5', 'aria-hidden': 'true' }) }}
							</a>
						{% endif %}
						{% for p in 1..totalPages %}
							{% if p == page %}
								<span class="btn join-item border-primary bg-step-soft" aria-current="page">{{ p }}</span>
							{% else %}
								<a href="{{ path('app_recipe_index', {page: p, q: q|default('')}) }}" class="btn join-item">{{ p }}</a>
							{% endif %}
						{% endfor %}
						{% if page < totalPages %}
							<a href="{{ path('app_recipe_index', {page: page + 1, q: q|default('')}) }}" class="btn join-item" aria-label="Page suivante">
								{{ ux_icon('lucide:chevron-left', { class: 'size-5 rotate-180', 'aria-hidden': 'true' }) }}
							</a>
						{% endif %}
					</div>
				</nav>
			{% endif %}
		{% endif %}
	</div>
{% endblock %}
