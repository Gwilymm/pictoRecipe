{% extends 'base.html.twig' %}

{% block title %}Recettes
{% endblock %}

{% block body %}
	<h1 class="text-3xl font-bold mb-6">Recettes</h1>

	<div class="overflow-x-auto">
		<table class="table table-zebra w-full">
			<thead>
				<tr>
					{# Id column removed for cleaner UI #}
					<th>Titre</th>
					<th>Description</th>
					<th>Portions</th>
					<th>Préparation</th>
					<th>Cuisson</th>
					<th>Créé le</th>
					<th>MàJ</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for recipe in recipes %}
					<tr>
						<td class="font-medium align-top">{{ recipe.title }}</td>
						<td class="align-top">
							<div class="max-w-[48ch] text-sm text-base-content/80 leading-6">{{ recipe.description }}</div>
						</td>
						<td>{{ recipe.servings }}</td>
						<td>{{ recipe.prepTimeMinutes }}</td>
						<td>{{ recipe.cookTimeMinutes }}</td>
						<td>{{ recipe.createdAt ? recipe.createdAt|date('Y-m-d') : '' }}</td>
						<td>{{ recipe.updatedAt ? recipe.updatedAt|date('Y-m-d') : '' }}</td>
						<td class="align-top">
							<div class="flex flex-col items-end gap-2">
								<a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-xs btn-info w-28 rounded-md shadow">👁️ Voir</a>
								<a href="{{ path('app_recipe_preview', {'id': recipe.id}) }}" class="btn btn-xs btn-primary w-28 rounded-md shadow">🔍 Prévisualiser</a>
								<a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="btn btn-xs btn-warning w-28 rounded-md shadow">✏️ Modifier</a>
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="8" class="text-center">Aucune recette trouvée</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<a href="{{ path('app_recipe_new') }}" class="btn btn-success mt-6">Ajouter une recette</a>
{% endblock %}
