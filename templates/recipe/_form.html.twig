{# Recipe main form partial with embedded Ingredients and Steps collections
	 Uses DaisyUI classes and a small Stimulus controller to add/remove collection items dynamically.
#}

{{ form_start(form, {'attr': {'class': 'space-y-6', 'data-controller': 'stepper'}}) }}

{# Determine submit label: prefer explicit `button_label`, otherwise infer from bound entity (has id => update) #}
{% set submit_label = (button_label is defined) ? button_label : ((form.vars.data is defined and form.vars.data.id) ? 'Mettre à jour' : 'Enregistrer la recette') %}
{% if form.ingredients is defined and form.ingredients.vars.prototype is defined %}
	{% set ingredient_prototype %}{{ form_widget(form.ingredients.vars.prototype.position) }}<div class="flex items-start gap-3">
		<div class="flex-1 grid grid-cols-3 gap-2">
			<div class="col-span-2">{{ form_widget(form.ingredients.vars.prototype.name) }}</div>
			<div class="col-span-1">{{ form_widget(form.ingredients.vars.prototype.amount) }}</div>
			<div class="col-span-1">{{ form_widget(form.ingredients.vars.prototype.unit) }}</div>
		</div>
		<div class="flex items-start">
			<button type="button" class="btn btn-sm btn-ghost btn-error js-remove">🗑</button>
		</div>
	</div>
	<div class="mt-3 pt-3 border-t border-base-300">{{ include('partials/_pictogram_widget.html.twig', {'form_field': form.ingredients.vars.prototype.name, 'url_field': form.ingredients.vars.prototype.pictogramUrl, 'placeholder': 'Rechercher un pictogramme pour cet ingrédient...', 'prefill': false}) }}</div>
	{% endset %}
{% else %}
	{% set ingredient_prototype = '' %}
{% endif %}

{% if form.steps is defined and form.steps.vars.prototype is defined %}
	{% set step_prototype %}{{ form_widget(form.steps.vars.prototype.position) }}<div class="flex gap-3 items-start">
		<div class="flex-1">{{ form_widget(form.steps.vars.prototype.content) }}</div>
		<div class="w-28">{{ form_widget(form.steps.vars.prototype.durationMinutes) }}</div>
		<div class="flex items-start">
			<button type="button" class="btn btn-sm btn-ghost btn-error js-remove">🗑</button>
		</div>
	</div>
	<div class="mt-3 pt-3 border-t border-base-300">
		<div class="mb-2 font-semibold text-sm">🎨 Pictogrammes pour cette étape (plusieurs possibles)</div>
		{{ include('partials/_pictogram_multiple_widget.html.twig', {'form_field': form.steps.vars.prototype.content, 'urls_field': form.steps.vars.prototype.pictogramUrls, 'placeholder': 'Recherchez des mots-clés : mélanger, beurre, sucre...'}) }}</div>
	{% endset %}
{% else %}
	{% set step_prototype = '' %}
{% endif %}

{# Stepper header #}
<div class="mb-6">
	<ul class="steps steps-horizontal w-full" data-stepper-target="header">
		<li class="step step-primary" data-stepper-target="stepItem" data-step-name="Informations">
			<span class="hidden sm:inline">Informations</span>
		</li>
		<li class="step" data-stepper-target="stepItem" data-step-name="Ingrédients">
			<span class="hidden sm:inline">Ingrédients</span>
		</li>
		<li class="step" data-stepper-target="stepItem" data-step-name="Étapes">
			<span class="hidden sm:inline">Étapes</span>
		</li>
		<li class="step" data-stepper-target="stepItem" data-step-name="Ustensiles">
			<span class="hidden sm:inline">Ustensiles</span>
		</li>
		<li class="step" data-stepper-target="stepItem" data-step-name="Aperçu">
			<span class="hidden sm:inline">Aperçu</span>
		</li>
	</ul>

	{# Nom de l'étape active sur mobile #}
	<div class="text-center mt-3 sm:hidden">
		<span class="badge badge-lg badge-primary" data-stepper-target="currentStepName">Informations</span>
	</div>
</div>

{# Step 1: Informations générales #}
<section class="card bg-base-100 shadow p-4" data-stepper-target="step">
	<div class="card-body">
		<h2 class="card-title">Informations générales</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div>
				{{ form_row(form.title) }}
			</div>
			<div>
				{{ form_row(form.servings) }}
				<div class="flex gap-2 mt-2">
					{{ form_row(form.prepTimeMinutes) }}
					{{ form_row(form.cookTimeMinutes) }}
				</div>
			</div>
		</div>

		{# Small JS enhancement: make utensil cards toggle the checkbox reliably and apply selected classes #}
		<script>
			document.addEventListener( 'DOMContentLoaded', () => {





document.querySelectorAll( '.utensil-card' ).forEach( ( label ) => {





const input = label.querySelector( 'input[type="checkbox"]' );
if ( ! input )



return;



const setSelected = ( checked ) => {





const img = label.querySelector( 'img' );
if ( checked )
{





label.classList.add( 'bg-primary/5', 'text-primary-600', 'border-primary', 'shadow-md' );
if ( img )
{





img.classList.remove( 'w-10', 'h-10' );
img.classList.add( 'w-8', 'h-8' );





}

}
else
{





label.classList.remove( 'bg-primary/5', 'text-primary-600', 'border-primary', 'shadow-md' );
if ( img )
{





img.classList.remove( 'w-8', 'h-8' );
img.classList.add( 'w-10', 'h-10' );





}

}

};

// initialize visual state
setSelected( input.checked );

// clicking the label toggles the input; wait a tick to read its state
label.addEventListener( 'click', () => {





setTimeout( () => {





setSelected( input.checked );
input.dispatchEvent( new Event( 'change',
{ bubbles: true } ) );





}, 0 );





} );

// keep visuals in sync when input changes directly
input.addEventListener( 'change', () => setSelected( input.checked ) );





} );





} );
		</script>
		<div class="mt-4">
			{{ form_row(form.description) }}
		</div>

		{# Boutons de navigation #}
		<div class="flex justify-end gap-2 mt-6 pt-4 border-t">
			<button type="button" class="btn btn-primary" data-action="stepper#next">
				Suivant : Ingrédients ▶
			</button>
		</div>
	</div>
</section>{# Step 2: Ingredients #}<section class="card bg-base-100 shadow p-4 hidden" data-stepper-target="step">
	<div class="card-body">
		<h3 class="text-lg font-semibold">🧂 Ingrédients</h3>

		<div data-controller="form-collection" data-prototype="{{ ingredient_prototype|e('html_attr') }}" class="mt-3 space-y-2">
			<div data-form-collection-target="list" class="space-y-2">
				{% for ingredient in form.ingredients %}
					<div
						class="collection-item card bg-base-200 p-3">
						{# Champ position caché #}
						{{ form_widget(ingredient.position) }}

						<div class="flex items-start gap-3">
							<div class="flex-1 grid grid-cols-3 gap-2">
								<div class="col-span-2">{{ form_widget(ingredient.name) }}</div>
								<div class="col-span-1">{{ form_widget(ingredient.amount) }}</div>
								<div class="col-span-1">{{ form_widget(ingredient.unit) }}</div>
							</div>
							<div class="flex items-start">
								<button type="button" class="btn btn-sm btn-ghost btn-error js-remove">🗑</button>
							</div>
						</div>

						<div class="mt-3 pt-3 border-t border-base-300">
							{{ include('partials/_pictogram_widget.html.twig', {
								'form_field': ingredient.name,
								'url_field': ingredient.pictogramUrl,
								'placeholder': 'Rechercher un pictogramme pour cet ingrédient...',
								'prefill': false
							}) }}
						</div>
					</div>
				{% else %}
					<p class="text-sm text-muted">Aucun ingrédient — ajoutez le premier.</p>
				{% endfor %}
			</div>

			<div class="mt-3">
				<button type="button" data-action="click->form-collection#add" class="btn btn-outline btn-primary">Ajouter un ingrédient</button>
			</div>
		</div>

		{# Boutons de navigation #}
		<div class="flex justify-between gap-2 mt-6 pt-4 border-t">
			<button type="button" class="btn btn-outline" data-action="stepper#prev">
				◀ Précédent
			</button>
			<button type="button" class="btn btn-primary" data-action="stepper#next">
				Suivant : Étapes ▶
			</button>
		</div>
	</div>
</section>
{# Step 3: Steps #}
<section class="card bg-base-100 shadow p-4 hidden" data-stepper-target="step">
	<div class="card-body">
		<h3 class="text-lg font-semibold">👨‍🍳 Étapes</h3>

		<div data-controller="form-collection" data-prototype="{{ step_prototype|e('html_attr') }}" class="mt-3 space-y-2">
			<div data-form-collection-target="list" class="space-y-2">
				{% for step in form.steps %}
					<div
						class="collection-item card bg-base-200 p-3">
						{# Champ position caché #}
						{{ form_widget(step.position) }}

						<div class="flex gap-3 items-start">
							<div class="flex-1">{{ form_widget(step.content) }}</div>
							<div class="w-28">{{ form_widget(step.durationMinutes) }}</div>
							<div class="flex items-start">
								<button type="button" class="btn btn-sm btn-ghost btn-error js-remove">🗑</button>
							</div>
						</div>

						{# Widget pour plusieurs pictogrammes #}
						<div class="mt-3 pt-3 border-t border-base-300">
							<div class="mb-2 font-semibold text-sm">🎨 Pictogrammes pour cette étape (plusieurs possibles)</div>
							{{ include('partials/_pictogram_multiple_widget.html.twig', {'urls_field': step.pictogramUrls,	'placeholder': 'Recherchez des mots-clés : mélanger, beurre, sucre...'}) }}
						</div>
					</div>
				{% else %}
					<p class="text-sm text-muted">Aucune étape — ajoutez la première.</p>
				{% endfor %}
			</div>

			<div class="mt-3">
				<button type="button" data-action="click->form-collection#add" class="btn btn-outline btn-secondary">Ajouter une étape</button>
			</div>
		</div>

		{# Boutons de navigation #}
		<div class="flex justify-between gap-2 mt-6 pt-4 border-t">
			<button type="button" class="btn btn-outline" data-action="stepper#prev">
				◀ Précédent
			</button>
			<button type="button" class="btn btn-primary" data-action="stepper#next">
				Suivant : Ustensiles ▶
			</button>
		</div>
	</div>
</section>{# Step 4: Utensils #}<section class="card bg-base-100 shadow p-4 hidden" data-stepper-target="step">
	<div class="card-body">
		<h3 class="text-lg font-semibold">🍴 Ustensiles</h3>
		<p class="text-sm text-base-content/70 mb-4">Sélectionnez les ustensiles utilisés dans cette recette.</p>

		{# Option 1: Sélection multiple depuis la liste existante #}
		<div class="mb-4">
			<label class="label">
				<span class="label-text font-semibold">Ustensiles disponibles</span>
			</label>

			{# Render expanded checkboxes as a grid of cards with pictograms (fallback emoji if missing) #}
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
				{% for child in form.utensils %}
					{# pictogram URL is exposed as a data attribute on the input via choice_attr in the form type #}
					{% set pictogram = child.vars.attr['data-pictogram']|default(null) %}
					{# Render the checkbox input inside the label so clicking anywhere toggles it reliably #}
					<label class="utensil-card relative flex items-center gap-3 p-2 pl-4 border rounded-lg cursor-pointer hover:shadow-sm bg-white transition-colors peer-checked:bg-primary/5 peer-checked:text-primary-600 peer-checked:border-primary">
						{{ form_widget(child, {'attr': {'class': 'peer sr-only'}}) }}
						{# Colored left indicator visible when selected #}
						<span class="absolute left-0 top-0 bottom-0 w-1 rounded-r bg-primary/70 opacity-0 transition-opacity duration-150 peer-checked:opacity-100" aria-hidden="true"></span>
						{% if pictogram %}
							<img src="{{ pictogram }}" alt="{{ child.vars.label }}" class="w-10 h-10 object-contain rounded transition-all peer-checked:w-8 peer-checked:h-8"/>
						{% else %}
							<div class="w-10 h-10 rounded bg-base-200 flex items-center justify-center text-lg transition-all peer-checked:w-8 peer-checked:h-8">🔪</div>
						{% endif %}

						<span class="ml-2">{{ child.vars.label }}</span>
					</label>
				{% else %}
					<p class="text-sm text-muted">Aucun ustensile — ajoutez-en un via la gestion d'ustensiles.</p>
				{% endfor %}
			</div>
		</div>

		{# Option 2: Lien pour ajouter un nouvel ustensile #}
		<div class="alert alert-info">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<div>
				<div class="text-sm">
					<strong>Ustensile manquant ?</strong><br/>
					Vous pouvez créer un nouvel ustensile avec son pictogramme.
				</div>
			</div>
			<a href="{{ path('app_utensil_new') }}" target="_blank" class="btn btn-sm btn-primary">
				➕ Créer un ustensile
			</a>
		</div>

		{# Boutons de navigation #}
		<div class="flex justify-between gap-2 mt-6 pt-4 border-t">
			<button type="button" class="btn btn-outline" data-action="stepper#prev">
				◀ Précédent
			</button>
			<button type="button" class="btn btn-primary" data-action="stepper#next">
				Suivant : Aperçu ▶
			</button>
		</div>
	</div>
</section>
<section class="card bg-base-100 shadow p-4 hidden" data-stepper-target="step">
	<div class="card-body">
		<h3 class="text-lg font-semibold">Aperçu</h3>
		<p class="text-sm text-base-content/70 mb-4">Aperçu de la fiche avant enregistrement (basé sur les valeurs du formulaire).</p>
		<div class="recipe-preview max-w-4xl mx-auto">
			{{ include('recipe/_preview.html.twig', { recipe: form.vars.data }) }}
		</div>
		{# Boutons de navigation et enregistrement #}
		<div class="flex justify-between gap-2 mt-6 pt-4 border-t">
			<button type="button" class="btn btn-outline" data-action="stepper#prev">
				◀ Précédent
			</button>
			<div class="flex gap-2">
				<a href="{{ path('app_recipe_index') }}" class="btn btn-ghost">Annuler</a>
				<button type="submit" class="btn btn-success gap-2">
					💾
					{{ submit_label }}
				</button>
			</div>
		</div>
	</div>
</section>{# Fallback submit actions (if user skips to bottom) #}<div class="mt-4 hidden">
	<button type="submit" class="btn btn-primary">{{ submit_label }}</button>
	<a href="{{ path('app_recipe_index') }}" class="btn btn-outline">Retour à la liste</a>
</div>
{# Render any remaining hidden fields (CSRF token, etc.) then close the form #}
{{ form_rest(form) }}
{{ form_end(form) }}
