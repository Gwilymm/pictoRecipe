{# Recipe main form partial with embedded Ingredients and Steps collections
	 Modern desktop-first UI with improved UX principles
#}

{{ form_start(form, {'attr': {'class': 'container mx-auto  sm:px-4 lg:px-8 py-6 md:py-8', 'data-controller': 'stepper'}}) }}

{# Determine submit label: prefer explicit `button_label`, otherwise infer from bound entity (has id => update) #}
{% set submit_label = (button_label is defined) ? button_label : ((form.vars.data is defined and form.vars.data.id) ? 'Mettre à jour' : 'Enregistrer la recette') %}
{% if form.ingredients is defined and form.ingredients.vars.prototype is defined %}
	{% set ingredient_prototype %}
	{{ form_widget(form.ingredients.vars.prototype.position) }}
	<div class="flex items-center justify-between mb-4">
		<div class="badge badge-accent badge-lg font-bold">Ingrédient</div>
		<button type="button" class="btn btn-ghost btn-error btn-sm md:btn-md js-remove" title="Supprimer cet ingrédient">
			{{ ux_icon('heroicons:trash', { class: 'w-5 h-5' }) }}
			<span class="sr-only">Supprimer cet ingrédient</span>
		</button>
	</div>

	<div class="flex flex-col gap-4 md:grid md:grid-cols-12 md:gap-4 items-start">
		<div class="md:col-span-6">
			<label class="label">
				<span class="label-text font-medium">Nom de l'ingrédient</span>
			</label>
			{{ form_widget(form.ingredients.vars.prototype.name, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'Ex: Farine'}}) }}
		</div>
		<div class="md:col-span-4">
			<label class="label">
				<span class="label-text font-medium">Section (groupe)</span>
			</label>
			{{ form_widget(form.ingredients.vars.prototype.section, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'Ex: Pâte sablée'}}) }}
		</div>
		<div class="md:col-span-3">
			<label class="label">
				<span class="label-text font-medium">Quantité</span>
			</label>
			{{ form_widget(form.ingredients.vars.prototype.amount, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': '250'}}) }}
		</div>
		<div class="md:col-span-2">
			<label class="label">
				<span class="label-text font-medium">Unité</span>
			</label>
			{{ form_widget(form.ingredients.vars.prototype.unit, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'g'}}) }}
		</div>
	</div>

	<div class="mt-4 md:mt-6 pt-4 md:pt-6 border-t border-base-300">
		<label class="label">
			<span class="label-text font-medium flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
				</svg>
				Pictogramme associé
			</span>
		</label>
		{{ include('partials/_pictogram_widget.html.twig', {
				'form_field': form.ingredients.vars.prototype.name,
				'url_field': form.ingredients.vars.prototype.pictogramUrl,
				'placeholder': 'Rechercher un pictogramme pour cet ingrédient...',
				'prefill': false
			}) }}
	</div>
	{% endset %}
{% else %}
	{% set ingredient_prototype = '' %}
{% endif %}

{% if form.steps is defined and form.steps.vars.prototype is defined %}
	{% set step_prototype %}{{ form_widget(form.steps.vars.prototype.position) }}<div class="flex flex-col sm:flex-row gap-2 md:gap-3 items-start">
		<div class="flex-1 w-full">{{ form_widget(form.steps.vars.prototype.content) }}</div>
		<div class="w-full sm:w-28">{{ form_widget(form.steps.vars.prototype.durationMinutes) }}</div>
		<div class="flex items-start w-full sm:w-auto">
			<button type="button" class="btn btn-xs md:btn-sm btn-ghost btn-error js-remove w-full sm:w-auto flex items-center justify-center gap-2" title="Supprimer">
				{{ ux_icon('heroicons:trash', {class: 'w-4 h-4'}) }}
				<span class="sr-only">Supprimer</span>
			</button>
		</div>
	</div>
	<div class="mt-2 md:mt-3 pt-2 md:pt-3 border-t border-base-300">
		<div class="mb-2 font-semibold text-xs md:text-sm">🎨 Pictogrammes pour cette étape (plusieurs possibles)</div>
		{{ include('partials/_pictogram_multiple_widget.html.twig', {'form_field': form.steps.vars.prototype.content, 'urls_field': form.steps.vars.prototype.pictogramUrls, 'placeholder': 'Recherchez des mots-clés : mélanger, beurre, sucre...'}) }}</div>
	{% endset %}
{% else %}
	{% set step_prototype = '' %}
{% endif %}

{# Stepper header - Modern desktop design #}
<div class="mb-8">
	<div class="max-w-5xl mx-auto">
		<ul class="steps steps-horizontal w-full" data-stepper-target="header">
			<li class="step step-primary" data-stepper-target="stepItem" data-step-name="Informations"></li>
			<li class="step" data-stepper-target="stepItem" data-step-name="Ingrédients"></li>
			<li class="step" data-stepper-target="stepItem" data-step-name="Étapes"></li>
			<li class="step" data-stepper-target="stepItem" data-step-name="Ustensiles"></li>
			<li class="step" data-stepper-target="stepItem" data-step-name="Aperçu"></li>
		</ul>
	</div>

	{# Current step indicator - visible on all screens #}
	<div class="text-center mt-6">
		<div class="inline-flex items-center gap-2 md:gap-3 bg-base-200 px-3 py-2 md:px-6 md:py-3 rounded-full">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
			</svg>
			<span class="font-semibold text-base" data-stepper-target="currentStepName">Informations</span>
		</div>
	</div>
</div>

{# Step 1: Informations générales - Modern desktop layout #}
<section class="max-w-5xl sm:w-full mx-auto" data-stepper-target="step">
	<div class="card bg-base-100 shadow-xl border border-base-300">
		<div
			class="card-body p-4 md:p-8">
			{# Section header #}
			<div class="flex items-center gap-4 mb-6 pb-6 border-b border-base-300">
				<div class="bg-primary/10 text-primary rounded-xl p-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-base-content">Informations générales</h2>
					<p class="text-sm text-base-content/70 mt-1">Commencez par les informations de base de votre recette</p>
				</div>
			</div>

			{# Form fields with modern layout #}
			<div
				class="space-y-6">
				{# Title - Full width #}
				<div class="form-control">
					{{ form_row(form.title, {
						'label_attr': {'class': 'label'},
						'attr': {'class': 'input input-bordered input-lg w-full focus:input-primary', 'placeholder': 'Ex: Gâteau au chocolat'}
					}) }}
				</div>

				{# Grid layout for numeric fields #}
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<div class="form-control">
						{{ form_row(form.servings, {
							'label_attr': {'class': 'label'},
							'attr': {'class': 'input input-bordered w-full focus:input-primary'}
						}) }}
					</div>
					<div class="form-control">
						{{ form_row(form.prepTimeMinutes, {
							'label_attr': {'class': 'label'},
							'attr': {'class': 'input input-bordered w-full focus:input-primary'}
						}) }}
					</div>
					<div class="form-control">
						{{ form_row(form.cookTimeMinutes, {
							'label_attr': {'class': 'label'},
							'attr': {'class': 'input input-bordered w-full focus:input-primary'}
						}) }}
					</div>
				</div>

				{# Description - Full width with larger textarea #}
				<div class="form-control">
					{{ form_row(form.description, {
						'label_attr': {'class': 'label'},
						'attr': {'class': 'textarea textarea-bordered h-32 w-full focus:textarea-primary', 'placeholder': 'Décrivez votre recette en quelques mots...'}
					}) }}
				</div>
			</div>

			{# Navigation buttons #}
			<div class="flex justify-end gap-3 mt-8 pt-6 border-t border-base-300">
				<button type="button" class="btn btn-primary btn-lg gap-2" data-action="stepper#next">
					Suivant
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>
{# Step 2: Ingredients - Modern desktop layout #}
<section class="max-w-5xl mx-auto hidden" data-stepper-target="step">
	<div class="card bg-base-100 shadow-xl border border-base-300">
		<div
			class="card-body p-4 md:p-8">
			{# Section header #}
			<div class="flex items-center gap-4 mb-6 pb-6 border-b border-base-300">
				<div class="bg-accent/10 text-accent rounded-xl p-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
					</svg>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-base-content">Ingrédients</h2>
					<p class="text-sm text-base-content/70 mt-1">Ajoutez tous les ingrédients nécessaires avec leurs quantités</p>
				</div>
			</div>

			{# Ingredients collection #}
			<div data-controller="form-collection" data-prototype="{{ ingredient_prototype|e('html_attr') }}" class="space-y-4">
				<div data-form-collection-target="list" class="space-y-4">
					{% for ingredient in form.ingredients %}
						<div
							class="collection-item bg-base-200/50 rounded-xl p-6 border-2 border-base-300 hover:border-primary/30 transition-colors">
							{# Position field #}
							{{ form_widget(ingredient.position) }}

							{# Ingredient header with delete button on the right (better mobile placement) #}
							<div class="flex items-center justify-between mb-4">
								<div class="badge badge-accent badge-lg font-bold">Ingrédient
									{{ loop.index }}</div>
								<button type="button" class="btn btn-ghost btn-error btn-sm md:btn-md js-remove" title="Supprimer cet ingrédient">
									{{ ux_icon('heroicons:trash', {class: 'w-5 h-5'}) }}
									<span class="sr-only">Supprimer l'ingrédient
										{{ loop.index }}</span>
								</button>
							</div>

							{# Ingredient fields in a clean grid #}
							<div class="flex flex-col gap-4 md:grid md:grid-cols-12 md:gap-4 items-start">
								<div class="md:col-span-6">
									<label class="label">
										<span class="label-text font-medium">Nom de l'ingrédient</span>
									</label>
									{{ form_widget(ingredient.name, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'Ex: Farine'}}) }}
								</div>
								<div class="md:col-span-4">
									<label class="label">
										<span class="label-text font-medium">Section (groupe)</span>
									</label>
									{{ form_widget(ingredient.section, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'Ex: Pâte sablée'}}) }}
								</div>
								<div class="md:col-span-3">
									<label class="label">
										<span class="label-text font-medium">Quantité</span>
									</label>
									{{ form_widget(ingredient.amount, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': '250'}}) }}
								</div>
								<div class="md:col-span-2">
									<label class="label">
										<span class="label-text font-medium">Unité</span>
									</label>
									{{ form_widget(ingredient.unit, {'attr': {'class': 'input input-bordered w-full focus:input-primary', 'placeholder': 'g'}}) }}
								</div>
							</div>

							{# Pictogram selector #}
							<div class="mt-4 md:mt-6 pt-4 md:pt-6 border-t border-base-300">
								<label class="label">
									<span class="label-text font-medium flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
										</svg>
										Pictogramme associé
									</span>
								</label>
								{{ include('partials/_pictogram_widget.html.twig', {
									'form_field': ingredient.name,
									'url_field': ingredient.pictogramUrl,
									'placeholder': 'Rechercher un pictogramme pour cet ingrédient...',
									'prefill': false
								}) }}
							</div>
						</div>
					{% else %}
						<div class="text-center py-12 bg-base-200/30 rounded-xl border-2 border-dashed border-base-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30 mb-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
							</svg>
							<p class="text-base-content/70 font-medium">Aucun ingrédient ajouté</p>
							<p class="text-sm text-base-content/50 mt-1">Cliquez sur le bouton ci-dessous pour ajouter votre premier ingrédient</p>
						</div>
					{% endfor %}
				</div>

				{# Add ingredient button #}
				<div class="pt-4">
					<button type="button" data-action="click->form-collection#add" class="btn btn-outline btn-primary btn-lg gap-2 w-full lg:w-auto">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
						</svg>
						Ajouter un ingrédient
					</button>
				</div>
			</div>

			{# Navigation buttons #}
			<div class="flex justify-between items-center gap-3 mt-8 pt-6 border-t border-base-300">
				<button type="button" class="btn btn-outline btn-lg gap-2" data-action="stepper#prev">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
					Précédent
				</button>
				<button type="button" class="btn btn-primary btn-lg gap-2" data-action="stepper#next">
					Suivant
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>
{# Step 3: Steps - Modern desktop layout #}
<section class="max-w-5xl mx-auto hidden" data-stepper-target="step">
	<div class="card bg-base-100 shadow-xl border border-base-300">
		<div
			class="card-body p-4 md:p-8">
			{# Section header #}
			<div class="flex items-center gap-4 mb-6 pb-6 border-b border-base-300">
				<div class="bg-secondary/10 text-secondary rounded-xl p-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
					</svg>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-base-content">Étapes de préparation</h2>
					<p class="text-sm text-base-content/70 mt-1">Détaillez les étapes de votre recette dans l'ordre</p>
				</div>
			</div>

			{# Steps collection #}
			<div data-controller="form-collection" data-prototype="{{ step_prototype|e('html_attr') }}" class="space-y-4">
				<div data-form-collection-target="list" class="space-y-4">
					{% for step in form.steps %}
						<div
							class="collection-item bg-base-200/50 rounded-xl p-6 border-2 border-base-300 hover:border-secondary/30 transition-colors">
							{# Position field #}
							{{ form_widget(step.position) }}

							{# Step header with delete button on the right #}
							<div class="flex items-center justify-between mb-4">
								<div class="badge badge-secondary badge-lg font-bold">Étape
									{{ loop.index }}</div>
								<button type="button" class="btn btn-ghost btn-error btn-sm md:btn-md js-remove" title="Supprimer cette étape">
									{{ ux_icon('heroicons:trash', {class: 'w-5 h-5'}) }}
									<span class="sr-only">Supprimer l'étape
										{{ loop.index }}</span>
								</button>
							</div>

							{# Step content and duration #}
							<div class="flex flex-col gap-4 md:grid md:grid-cols-12 md:gap-4 items-start">
								<div class="md:col-span-9 w-full">
									<label class="label">
										<span class="label-text font-medium">Description de l'étape</span>
									</label>
									{{ form_widget(step.content, {'attr': {'class': 'textarea textarea-bordered h-24 w-full focus:textarea-secondary', 'placeholder': 'Décrivez cette étape en détail...'}}) }}
								</div>
								<div class="md:col-span-2 w-full md:w-auto">
									<label class="label">
										<span class="label-text font-medium">Durée (min)</span>
									</label>
									{{ form_widget(step.durationMinutes, {'attr': {'class': 'input input-bordered w-full focus:input-secondary', 'placeholder': '15'}}) }}
								</div>

							</div>
							<div class="mt-4 md:mt-6 pt-4 md:pt-6 border-t border-base-300 w-full">
								<label class="label">
									<span class="label-text font-medium flex flex-col sm:flex-row items-start sm:items-center gap-1 sm:gap-2">

										<span class="flex items-center gap-2">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
											</svg>
											Pictogrammes pour cette étape
										</span>

										<span class="badge badge-sm">Plusieurs possibles</span>
									</span>
								</label>

								<div class="flex flex-wrap gap-2 w-full">
									{{ include('partials/_pictogram_multiple_widget.html.twig', {
										'urls_field': step.pictogramUrls,
										'placeholder': 'Recherchez des mots-clés : mélanger, beurre, sucre...'
									}) }}
								</div>
							</div>
						</div>
					{% else %}
						<div class="text-center py-12 bg-base-200/30 rounded-xl border-2 border-dashed border-base-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30 mb-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
							</svg>
							<p class="text-base-content/70 font-medium">Aucune étape ajoutée</p>
							<p class="text-sm text-base-content/50 mt-1">Cliquez sur le bouton ci-dessous pour ajouter votre première étape</p>
						</div>
					{% endfor %}
				</div>

				{# Add step button #}
				<div class="pt-4">
					<button type="button" data-action="click->form-collection#add" class="btn btn-outline btn-secondary btn-lg gap-2 w-full lg:w-auto">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
						</svg>
						Ajouter une étape
					</button>
				</div>
			</div>

			{# Navigation buttons #}
			<div class="flex justify-between items-center gap-3 mt-8 pt-6 border-t border-base-300">
				<button type="button" class="btn btn-outline btn-lg gap-2" data-action="stepper#prev">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
