{# Step 4: Utensils - Modern desktop layout #}
<section class="max-w-5xl mx-auto hidden" data-stepper-target="step">
	<div class="card bg-base-100 shadow-xl border border-base-300">
		<div
			class="card-body p-4 md:p-8">
			{# Section header #}
			<div class="flex items-center gap-4 mb-6 pb-6 border-b border-base-300">
				<div class="bg-info/10 text-info rounded-xl p-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-base-content">Ustensiles nécessaires</h2>
					<p class="text-sm text-base-content/70 mt-1">Sélectionnez tous les ustensiles utilisés dans cette recette</p>
				</div>
			</div>

			{# Utensils selection grid #}
			<div class="mb-6">
				{% if form.utensils|length > 0 %}
					<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
						{% for child in form.utensils %}
							{% set pictogram = child.vars.attr['data-pictogram']|default(null) %}

							<label class="utensil-card group cursor-pointer">
								{{ form_widget(child, {'attr': {'class': 'peer hidden'}}) }}

								<div
									class="flex flex-col items-center gap-3 p-5 rounded-2xl border-2 border-base-300 bg-base-100 transition-all duration-200 hover:shadow-lg hover:scale-105 peer-checked:border-info peer-checked:bg-info/5 peer-checked:shadow-xl">
									{# Pictogram or fallback icon #}
									<div class="w-16 h-16 flex items-center justify-center">
										{% if pictogram %}
											<img src="{{ pictogram }}" alt="{{ child.vars.label }}" class="w-full h-full object-contain transition-transform group-hover:scale-110"/>
										{% else %}
											<div class="w-full h-full rounded-xl bg-base-200 flex items-center justify-center text-3xl">
												🔪
											</div>
										{% endif %}
									</div>

									{# Label #}
									<span class="text-sm font-medium text-center leading-tight">{{ child.vars.label }}</span>

									{# Check indicator #}
									<div class="w-6 h-6 rounded-full border-2 border-base-300 bg-base-100 flex items-center justify-center peer-checked:border-info peer-checked:bg-info peer-checked:text-white transition-colors">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden peer-checked:block" fill="none" viewbox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
										</svg>
									</div>
								</div>
							</label>
						{% endfor %}
					</div>
				{% else %}
					<div class="text-center py-12 bg-base-200/30 rounded-xl border-2 border-dashed border-base-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30 mb-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
						</svg>
						<p class="text-base-content/70 font-medium">Aucun ustensile disponible</p>
						<p class="text-sm text-base-content/50 mt-1">Créez d'abord des ustensiles pour pouvoir les sélectionner</p>
					</div>
				{% endif %}
			</div>

			{# Helper card #}
			<div class="alert border-info/20">
				<div class="flex items-start gap-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info shrink-0 mt-0.5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
					<div class="flex-1">
						<h4 class="font-semibold text-base mb-1">Ustensile manquant ?</h4>
						<p class="text-sm text-base-content/70 mb-3">
							Vous pouvez créer de nouveaux ustensiles avec leurs pictogrammes avant de compléter votre recette.
						</p>
						<a href="{{ path('app_utensil_new') }}" target="_blank" class="btn btn-sm btn-info gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
							</svg>
							Créer un nouvel ustensile
						</a>
					</div>
				</div>
			</div>

			{# Navigation buttons #}
			<div class="flex justify-between items-center gap-3 mt-8 pt-6 border-t border-base-300">
				<button type="button" class="btn btn-outline btn-lg gap-2" data-action="stepper#prev">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
					Précédent
				</button>
				<button type="button" class="btn btn-primary btn-lg gap-2" data-action="stepper#next">
					Suivant
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

{# JavaScript for utensil card interactions #}
<script>
	document.addEventListener( 'DOMContentLoaded', () => {





document.querySelectorAll( '.utensil-card' ).forEach( ( label ) => {





const input = label.querySelector( 'input[type="checkbox"]' );
if ( ! input )



return;



const updateState = ( checked ) => {





const card = label.querySelector( 'div' );
if ( checked )
{





card.classList.add( 'ring-2', 'ring-info' );





}
else
{





card.classList.remove( 'ring-2', 'ring-info' );





}

};

// Initialize state
updateState( input.checked );

// Update on change
input.addEventListener( 'change', () => {





updateState( input.checked );





} );





} );





} );
</script>

