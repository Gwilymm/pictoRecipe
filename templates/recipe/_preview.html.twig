{% import '_ds/_ui.html.twig' as ui %}
{#
	Fiche recette visuelle : en-tête, ingrédients, ustensiles, préparation.
	Utilisée dans la page de prévisualisation (lecture) et dans l'assistant (étape 5, ingredient_sortable).
	stepper_controller.js reconstruit les trois listes en direct dans l'assistant : les id et data-* sont
	lus par stepper / pictogram-autofill / recipe-image-crop, ne pas les renommer.
#}

{% set ingredient_sortable = ingredient_sortable|default(false) %}
{% set heading = ingredient_sortable ? 'h2' : 'h1' %}
{% set empty_class = 'rounded-box border-2 border-dashed border-base-300 bg-base-100 p-6 text-center text-muted' %}
{% set recipeImageSrc = ui.recipe_image_src(recipe)|trim %}

<article class="space-y-6">
	{# En-tête #}
	<header class="flex flex-col-reverse gap-6 rounded-box border border-base-300 bg-base-100 p-5 sm:flex-row sm:items-start sm:justify-between">
		<div class="min-w-0 flex-1 space-y-4">
			<{{ heading }} class="text-2xl" data-recipe-title>{{ recipe.title|default('Titre de la recette') }}</{{ heading }}>

			{% if recipe.description %}
				<p class="max-w-3xl">{{ recipe.description }}</p>
			{% endif %}

			{% if recipe.servings or recipe.prepTimeMinutes or recipe.cookTimeMinutes %}
				<ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
					{% if recipe.servings %}
						<li class="inline-flex items-center gap-2">
							{{ ux_icon('lucide:users', { class: 'size-5 text-secondary', 'aria-hidden': 'true' }) }}
							{{ recipe.servings }} part{{ recipe.servings > 1 ? 's' : '' }}
						</li>
					{% endif %}
					{% if recipe.prepTimeMinutes %}
						<li class="inline-flex items-center gap-2">
							{{ ux_icon('lucide:clock', { class: 'size-5 text-secondary', 'aria-hidden': 'true' }) }}
							Préparation {{ recipe.prepTimeMinutes }} min
						</li>
					{% endif %}
					{% if recipe.cookTimeMinutes %}
						<li class="inline-flex items-center gap-2">
							{{ ux_icon('lucide:clock', { class: 'size-5 text-secondary', 'aria-hidden': 'true' }) }}
							Cuisson {{ recipe.cookTimeMinutes }} min
						</li>
					{% endif %}
				</ul>
			{% endif %}

			{% if recipe.updatedAt or recipe.createdAt %}
				<p class="text-sm text-muted">
					{{ recipe.updatedAt ? 'Mise à jour le ' ~ recipe.updatedAt|date('d/m/Y') : 'Créée le ' ~ recipe.createdAt|date('d/m/Y') }}
				</p>
			{% endif %}
		</div>

		<div
			class="relative w-full shrink-0 overflow-hidden rounded-box bg-base-200 sm:w-52{{ recipeImageSrc ? '' : ' hidden' }}"
			style="aspect-ratio: 4 / 3;"
			data-recipe-main-image-frame
		>
			<img
				src="{{ recipeImageSrc }}"
				alt=""
				class="absolute inset-0 h-full w-full object-cover"
				style="{{ ui.recipe_image_style(recipe) }}"
				data-recipe-main-image
			>
		</div>
	</header>

	{# Ingrédients #}
	<section class="space-y-3" aria-labelledby="titre-ingredients">
		{{ ui.section_title('Ingrédients', 'ingredient', ingredient_sortable ? null : recipe.ingredients|length, 'titre-ingredients') }}

		{% if recipe.ingredients is not empty %}
			{# Regroupement par section en gardant l'index d'origine (correspondance avec le formulaire) #}
			{% set ingredientsBySection = {} %}
			{% for ingredient in recipe.ingredients %}
				{% set section = ingredient.section|default('') %}
				{% set ingredientsBySection = ingredientsBySection|merge({(section): (ingredientsBySection[section] ?? [])|merge([{idx: loop.index0, ingredient: ingredient}])}) %}
			{% endfor %}

			<div id="preview-ingredients-container" class="space-y-6" data-preview-ingredient-sort>
				{% if ingredient_sortable %}
					<p class="text-muted">Glissez une carte pour changer l’ordre des ingrédients ou leur groupe.</p>
				{% endif %}

				{% for section, items in ingredientsBySection %}
					<div class="space-y-3" data-preview-ingredient-group>
						{% if section or ingredient_sortable %}
							<h3 class="flex items-center gap-2 text-base">
								{{ section ?: 'Sans groupe' }}
								<span class="rounded-full bg-ingredient-soft px-2 text-sm font-bold" data-preview-ingredient-count>{{ items|length }}</span>
							</h3>
						{% endif %}
						<ul class="grid min-h-20 grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6" data-preview-ingredient-drop-zone data-section-label="{{ section|e('html_attr') }}">
							{% for item in items %}
								{{ ui.ingredient_card(item.ingredient, item.idx, ingredient_sortable) }}
							{% endfor %}
						</ul>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div id="preview-ingredients-container" class="{{ empty_class }}">Aucun ingrédient pour cette recette.</div>
		{% endif %}
	</section>

	{# Ustensiles #}
	<section class="space-y-3" aria-labelledby="titre-ustensiles">
		{{ ui.section_title('Ustensiles', 'utensil', ingredient_sortable ? null : recipe.utensils|length, 'titre-ustensiles') }}

		{% if recipe.utensils is not empty %}
			<div id="preview-utensils-container">
				<ul class="grid grid-cols-4 gap-3 sm:grid-cols-6 lg:grid-cols-8">
					{% for utensil in recipe.utensils %}
						{{ ui.utensil_tile(utensil, loop.index0) }}
					{% endfor %}
				</ul>
			</div>
		{% else %}
			<div id="preview-utensils-container" class="{{ empty_class }}">Aucun ustensile pour cette recette.</div>
		{% endif %}
	</section>

	{# Préparation #}
	<section class="space-y-3" aria-labelledby="titre-preparation">
		{{ ui.section_title('Préparation', 'step', ingredient_sortable ? null : recipe.steps|length, 'titre-preparation') }}

		{% if recipe.steps is not empty %}
			<div id="preview-steps-container">
				<ol class="space-y-2">
					{% for step in recipe.steps %}
						{{ ui.step_card(loop.index, step) }}
					{% endfor %}
				</ol>
			</div>
		{% else %}
			<div id="preview-steps-container" class="{{ empty_class }}">Aucune étape de préparation.</div>
		{% endif %}
	</section>

	</article>
