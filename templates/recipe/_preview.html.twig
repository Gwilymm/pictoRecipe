{# 
  Template de prévisualisation de recette
  Affiche une fiche visuelle style "pictogramme" avec ingrédients, ustensiles et étapes
  Utilisé dans le stepper (étape 5) et dans la page de prévisualisation complète
#}

<div
	class="recipe-preview max-w-4xl mx-auto">
	{# En-tête de la recette #}
	<div class="card bg-linear-to-br from-primary/10 to-accent/10 shadow-lg mb-6">
		<div class="card-body">
			<h2 class="card-title text-3xl font-bold text-primary">
				{{ recipe.title|default('Titre de la recette') }}
			</h2>

			{% if recipe.description %}
				<p class="text-base-content/80 mt-2">{{ recipe.description }}</p>
			{% endif %}

			{# Informations rapides #}
			<div class="flex flex-wrap gap-4 mt-4">
				{% if recipe.servings %}
					<div class="badge badge-lg badge-primary gap-2">
						<span class="text-xl">👥</span>
						<span>{{ recipe.servings }}
							portion(s)</span>
					</div>
				{% endif %}

				{% if recipe.prepTimeMinutes %}
					<div class="badge badge-lg badge-secondary gap-2">
						<span class="text-xl">⏱️</span>
						<span>{{ recipe.prepTimeMinutes }}
							min préparation</span>
					</div>
				{% endif %}

				{% if recipe.cookTimeMinutes %}
					<div class="badge badge-lg badge-accent gap-2">
						<span class="text-xl">🔥</span>
						<span>{{ recipe.cookTimeMinutes }}
							min cuisson</span>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	<div class="divider text-lg font-semibold">🧂 Ingrédients</div>

	{# Section Ingrédients #}
	{% if recipe.ingredients is not empty %}
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-6">
			{% for ingredient in recipe.ingredients %}
				<div class="card bg-base-200 shadow hover:shadow-lg transition-shadow">
					<div
						class="card-body p-4 text-center">
						{# Pictogramme de l'ingrédient #}
						{% if ingredient.pictogramUrl %}
							<div class="flex justify-center mb-2">
								<img src="{{ ingredient.pictogramUrl }}" alt="{{ ingredient.name }}" class="w-16 h-16 object-contain rounded-lg">
							</div>
						{% else %}
							<div class="flex justify-center mb-2">
								<div class="w-16 h-16 rounded-lg bg-base-300 flex items-center justify-center text-3xl">
									🍴
								</div>
							</div>
						{% endif %}

						{# Nom et quantité #}
						<h4 class="font-semibold text-sm">{{ ingredient.name }}</h4>
						<p class="text-primary font-bold">
							{{ ingredient.amount }}
							{{ ingredient.unit|default('') }}
						</p>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6">
			<span>Aucun ingrédient défini pour cette recette.</span>
		</div>
	{% endif %}

	<div class="divider text-lg font-semibold">🍴 Ustensiles</div>

	{# Section Ustensiles #}
	{% if recipe.utensils is not empty %}
		<div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-3 mb-6">
			{% for utensil in recipe.utensils %}
				<div class="card bg-base-200 shadow hover:shadow-lg transition-shadow">
					<div
						class="card-body p-3 text-center">
						{# Pictogramme de l'ustensile #}
						{% if utensil.pictogramUrl %}
							<div class="flex justify-center mb-1">
								<img src="{{ utensil.pictogramUrl }}" alt="{{ utensil.name }}" class="w-12 h-12 object-contain rounded-md">
							</div>
						{% else %}
							<div class="flex justify-center mb-1">
								<div class="w-12 h-12 rounded-md bg-base-300 flex items-center justify-center text-2xl">
									🔪
								</div>
							</div>
						{% endif %}

						<p class="text-xs font-medium">{{ utensil.name }}</p>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6">
			<span>Aucun ustensile spécifié.</span>
		</div>
	{% endif %}

	<div class="divider text-lg font-semibold">👨‍🍳 Préparation</div>

	{# Section Étapes de préparation #}
	{% if recipe.steps is not empty %}
		<div class="space-y-4 mb-6">
			{% for step in recipe.steps %}
				<div class="card bg-base-100 shadow-md border-l-4 border-primary hover:shadow-lg transition-shadow">
					<div class="card-body p-4">
						<div
							class="flex gap-4 items-start">
							{# Pictogrammes de l'étape (peut en avoir plusieurs) #}
							<div class="shrink-0">
								{% if step.pictogramUrls and step.pictogramUrls is not empty %}
									{# Plusieurs pictogrammes #}
									<div class="flex flex-wrap gap-1">
										{% for pictoUrl in step.pictogramUrls %}
											<img src="{{ pictoUrl }}" alt="Picto" class="w-16 h-16 object-contain rounded-lg bg-base-200 p-1">
										{% endfor %}
									</div>
								{% elseif step.pictogramUrl %}
									{# Un seul pictogramme (ancien format) #}
									<img src="{{ step.pictogramUrl }}" alt="Étape {{ loop.index }}" class="w-20 h-20 object-contain rounded-lg bg-base-200 p-2">
								{% else %}
									{# Pas de pictogramme, afficher le numéro #}
									<div class="w-20 h-20 rounded-lg bg-base-200 flex items-center justify-center text-3xl">
										{{ loop.index }}
									</div>
								{% endif %}
							</div>

							{# Contenu de l'étape #}
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-2">
									<span class="badge badge-primary badge-lg">Étape
										{{ loop.index }}</span>
									{% if step.durationMinutes %}
										<span class="badge badge-ghost gap-1">
											⏱️
											{{ step.durationMinutes }}
											min
										</span>
									{% endif %}
								</div>
								<p class="text-base leading-relaxed">{{ step.content }}</p>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6">
			<span>Aucune étape de préparation définie.</span>
		</div>
	{% endif %}

	{# Message de succès en bas #}
	<div class="card bg-success/10 border-2 border-success mt-8">
		<div class="card-body text-center">
			<h3 class="card-title justify-center text-success text-2xl">🎉 Bonne dégustation !</h3>
			<p class="text-base-content/70">Votre recette illustrée est prête.</p>
		</div>
	</div>
</div>
