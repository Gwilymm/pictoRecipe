{# 
  Template de prévisualisation de recette
  Affiche une fiche visuelle style "pictogramme" avec ingrédients, ustensiles et étapes
  Utilisé dans le stepper (étape 5) et dans la page de prévisualisation complète
#}

{# En-tête de la recette #}
<div class="card bg-linear-to-br from-primary/10 to-accent/10 shadow-lg mb-6">
	<div class="card-body">
		<h2 class="card-title text-3xl font-bold text-primary">
			{{ recipe.title|default('Titre de la recette') }}
		</h2>

			<div class="md:flex md:justify-between md:items-start gap-4 mt-2">
				<div class="md:flex-1">
					{% if recipe.description %}
						<p class="text-base-content/80 mt-2">{{ recipe.description }}</p>
					{% endif %}
				</div>

				{# Compact info box on the right #}
				<div class="mt-4 md:mt-0 ml-0 md:ml-6">
					<div class="shadow rounded-lg p-3 bg-base-100 text-sm text-base-content/80">
						<div class="flex items-center gap-3 mb-2">
							{% if recipe.servings %}
								<div class="flex items-center gap-2">
									<span class="text-xl">👥</span>
									<span>{{ recipe.servings }}
										part{{ recipe.servings>1 ? 's' : '' }}</span>
								</div>
							{% endif %}
							{% if recipe.prepTimeMinutes %}
								<div class="flex items-center gap-2">
									<span class="text-xl">⏱️</span>
									<span>{{ recipe.prepTimeMinutes }}
										min</span>
								</div>
							{% endif %}
							{% if recipe.cookTimeMinutes %}
								<div class="flex items-center gap-2">
									<span class="text-xl">🔥</span>
									<span>{{ recipe.cookTimeMinutes }}
										min</span>
								</div>
							{% endif %}
						</div>

						<div class="text-xs text-base-content/60 mt-2">
							{% if recipe.createdAt %}
								<div>Créé le :
									{{ recipe.createdAt|date('Y-m-d') }}</div>
							{% endif %}
							{% if recipe.updatedAt %}
								<div>MàJ :
									{{ recipe.updatedAt|date('Y-m-d') }}</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="divider text-lg font-semibold">🧂 Ingrédients</div>

	{# Section Ingrédients #}
	{% if recipe.ingredients is not empty %}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-6" id="preview-ingredients-container">
			{% for ingredient in recipe.ingredients %}
				<div class="card bg-base-200 shadow hover:shadow-lg transition-shadow">
					<div
						class="card-body p-4 text-center">
						{# Pictogramme de l'ingrédient #}
						{% if ingredient.pictogram %}
							<div class="flex justify-center mb-2">
								<img src="{{ asset(ingredient.pictogram.filePath) }}" alt="{{ ingredient.name }}" class="w-16 h-16 object-contain rounded-lg">
							</div>
						{% elseif ingredient.pictogramUrl %}
							<div class="flex justify-center mb-2">
								<img src="{{ ingredient.pictogramUrl }}" alt="{{ ingredient.name }}" class="w-16 h-16 object-contain rounded-lg">
							</div>
						{% else %}
							<div class="flex justify-center mb-2">
								<div class="w-16 h-16 rounded-lg bg-base-300 flex items-center justify-center text-3xl">
									🍴
								</div>
							</div>
						{% endif %}

						{# Nom et quantité #}
						<h4 class="font-semibold text-sm">{{ ingredient.name }}</h4>
						<p class="text-primary font-bold">
							{{ ingredient.amount }}
							{{ ingredient.unit|default('') }}
						</p>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6" id="preview-ingredients-container">
			<span>Aucun ingrédient défini pour cette recette.</span>
		</div>
	{% endif %}

	<div class="divider text-lg font-semibold">🍴 Ustensiles</div>

	{# Section Ustensiles #}
	{% if recipe.utensils is not empty %}
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6" id="preview-utensils-container">
			{% for utensil in recipe.utensils %}
				<div class="card bg-base-200 shadow hover:shadow-lg transition-shadow">
					<div
						class="card-body p-3 text-center">
						{# Pictogramme de l'ustensile #}
						{% if utensil.pictogram %}
							<div class="flex justify-center mb-1">
								<img src="{{ asset(utensil.pictogram.filePath) }}" alt="{{ utensil.name }}" class="w-12 h-12 object-contain rounded-md">
							</div>
						{% elseif utensil.pictogramUrl %}
							<div class="flex justify-center mb-1">
								<img src="{{ utensil.pictogramUrl }}" alt="{{ utensil.name }}" class="w-12 h-12 object-contain rounded-md">
							</div>
						{% else %}
							<div class="flex justify-center mb-1">
								<div class="w-12 h-12 rounded-md bg-base-300 flex items-center justify-center text-2xl">
									🔪
								</div>
							</div>
						{% endif %}

						<p class="text-xs font-medium">{{ utensil.name }}</p>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6" id="preview-utensils-container">
			<span>Aucun ustensile spécifié.</span>
		</div>
	{% endif %}

	<div class="divider text-lg font-semibold">👨‍🍳 Préparation</div>

	{# Section Étapes de préparation #}
	{% if recipe.steps is not empty %}
		<div class="space-y-4 mb-6" id="preview-steps-container">
			{% for step in recipe.steps %}
				<div class="card bg-base-100 shadow-md border-l-4 border-primary hover:shadow-lg transition-shadow">
					<div class="card-body p-4">
						<div class="flex gap-4 items-start">
							{# Colonne gauche : numéro d'étape + pictogrammes en dessous #}
							<div class="flex flex-col items-center gap-3 shrink-0 w-28">
								<span class="badge badge-primary badge-lg">Étape {{ loop.index }}</span>
								<div class="mt-2">
									{% if step.pictogram %}
										<img src="{{ asset(step.pictogram.filePath) }}" alt="Étape {{ loop.index }}" class="w-20 h-20 object-contain rounded-lg bg-base-200 p-2 mx-auto">
									{% elseif step.pictogramUrls and step.pictogramUrls is not empty %}
										{# Affiche les pictogrammes en 2 colonnes #}
										<div class="grid grid-cols-2 gap-2">
											{% for pictoUrl in step.pictogramUrls %}
												<img src="{{ pictoUrl }}" alt="Picto" class="w-16 h-16 object-contain rounded-lg bg-base-200 p-1 mx-auto">
											{% endfor %}
										</div>
									{% elseif step.pictogramUrl %}
										<img src="{{ step.pictogramUrl }}" alt="Étape {{ loop.index }}" class="w-20 h-20 object-contain rounded-lg bg-base-200 p-2 mx-auto">
									{% else %}
										<div class="w-20 h-20 rounded-lg bg-base-200 flex items-center justify-center text-3xl mx-auto">
											{{ loop.index }}
										</div>
									{% endif %}
								</div>
							</div>

							{# Colonne droite : durée + contenu texte #}
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-2">
									{% if step.durationMinutes %}
										<span class="badge badge-ghost gap-1">⏱️ {{ step.durationMinutes }} min</span>
									{% endif %}
								</div>
								<p class="text-base leading-relaxed">{{ step.content }}</p>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="alert alert-info mb-6" id="preview-steps-container">
			<span>Aucune étape de préparation définie.</span>
		</div>
	{% endif %}

	{# Message de succès en bas #}
	<div class="card bg-success/10 border-2 border-success mt-8">
		<div class="card-body text-center">
			<h3 class="card-title justify-center text-success text-2xl">🎉 Bonne dégustation !</h3>
			<p class="text-base-content/70">Votre recette illustrée est prête.</p>
		</div>
	</div>
