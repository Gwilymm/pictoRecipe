{% extends 'base.html.twig' %}

{% block title %}
	{{ recipe.title }}
	- Prévisualisation
{% endblock %}

{% block body %}
	<div
		class="container mx-auto px-4 py-6">
		{# Barre d'actions en haut: ajout d'un bouton Enregistrer et réorganisation #}
		<div class="flex flex-wrap gap-3 mb-6 items-center justify-between">
			<div class="flex items-center gap-3">
				<a href="{{ path('app_recipe_index') }}" class="btn btn-outline btn-sm">
					← Retour à la liste
				</a>
				<a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-outline btn-primary btn-sm">
					✏️ Modifier
				</a>
			</div>
			<div
				class="flex items-center gap-3">
				{# Hidden save form: renders all fields inside a hidden container so the visible save buttons can submit it via form attribute #}
				{{ form_start(form, {'action': path('app_recipe_preview_save'), 'attr': {'id': 'preview-save-form'}}) }}
				<div
					style="display:none;">
					{# ensure the id is sent when editing existing recipes #}
					{% if recipe.id is defined and recipe.id %}
						<input type="hidden" name="recipe[id]" value="{{ recipe.id }}"/>
					{% endif %}
					{{ form_widget(form) }}
				</div>
				{{ form_end(form) }}

				<button form="preview-save-form" class="btn btn-success btn-sm" title="Enregistrer la recette (reste sur la prévisualisation)">
					💾
					{% if recipe.id %}Mettre à jour{% else %}Enregistrer
					{% endif %}
				</button>

				<a href="{{ path('app_recipe_pdf', {id: recipe.id, download: 1}) }}" class="btn btn-primary btn-sm gap-2" aria-label="Télécharger en PDF">
					📄 Télécharger en PDF
				</a>
				<a href="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, force: 1}) }}" class="btn btn-outline" aria-label="Régénérer le PDF (forcer)">
					🔁 Régénérer le PDF (forcer)
				</a>
			</div>
		</div>

		{# Inclusion du template de prévisualisation #}
		{{ include('recipe/_preview.html.twig', { recipe: recipe }) }}

		{# Actions en bas: Enregistrer en évidence #}
		<div class="flex flex-wrap gap-3 mt-6 justify-center">
			<a href="{{ path('app_recipe_index') }}" class="btn btn-outline">
				← Retour à la liste
			</a>
			<button form="preview-save-form" class="btn btn-success">
				💾
				{% if recipe.id %}Mettre à jour{% else %}Enregistrer la recette
				{% endif %}
			</button>
			<a href="{{ path('app_recipe_pdf', {id: recipe.id, download: 1}) }}" class="btn btn-primary">
				📄 Télécharger le PDF
			</a>
			<a href="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, force: 1}) }}" class="btn btn-outline">
				🔁 Régénérer le PDF (forcer)
			</a>
		</div>
	</div>
{% endblock %}
