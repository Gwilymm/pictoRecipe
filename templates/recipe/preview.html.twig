{% extends 'base.html.twig' %}

{% block title %}
	{{ recipe.title }}
	- Prévisualisation
{% endblock %}

{% block body %}
	<div
		class="space-y-6"
		data-controller="pictogram-autofill"
		data-pictogram-autofill-recipe-id-value="{{ recipe.id }}"
	>
		<nav class="flex flex-wrap items-center justify-between gap-3" aria-label="Actions de la recette">
			<a href="{{ path('app_recipe_index') }}" class="btn btn-ghost">
				{{ ux_icon('lucide:chevron-left', { class: 'size-5', 'aria-hidden': 'true' }) }}
				Toutes les recettes
			</a>
			<div class="flex flex-wrap gap-3">
				<a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-outline">
					{{ ux_icon('lucide:pencil', { class: 'size-5', 'aria-hidden': 'true' }) }}
					Modifier
				</a>
				<a href="#" data-pdf-url="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, v: (recipe.updatedAt ?? recipe.createdAt)|date('U')}) }}" class="btn btn-primary pdf-download-btn">
					{{ ux_icon('lucide:download', { class: 'size-5', 'aria-hidden': 'true' }) }}
					Télécharger le PDF
				</a>
			</div>
		</nav>
		{# Inclusion du template de prévisualisation #}
		{{ include('recipe/_preview.html.twig', {recipe: recipe}) }}

		{# Hidden form so the preview can submit updates (pictogramUrl fields) via JS. It's hidden in preview to avoid duplicating UI. #}
		<div style="display:none;">
			<form id="preview-save-form" action="{{ path('app_recipe_edit', {id: recipe.id}) }}" method="POST">
				{{ form_widget(form) }}
				<button id="preview-save-btn" type="submit">Save</button>
			</form>
			<div data-pictogram-autofill-target="status" class="text-sm mt-2"></div>
		</div>

		{# Modal for suggestions #}
		<div id="pictogram-proposals-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" aria-hidden="true">
			<div class="bg-base-100 rounded-lg p-4 w-full max-w-[90vw] max-h-[90vh] flex flex-col shadow-lg">
				<div class="flex justify-between items-center mb-3">
					<h3 class="text-lg font-bold">Choisir un pictogramme</h3>
					<button type="button" class="btn btn-ghost btn-square" aria-label="Fermer" data-action="click->pictogram-autofill#closeModal">✕</button>
				</div>

				{# Champ de recherche #}
				<div class="mb-3">
					<input type="search" id="pictogram-proposals-search" aria-label="Rechercher un pictogramme" placeholder="Rechercher un pictogramme..." class="input input-bordered input-sm w-full" autocomplete="off">
				</div>

				<div id="pictogram-proposals-list" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-2 overflow-y-auto flex-1"></div>
				<div class="mt-3 text-right border-t pt-3">
					<button class="btn btn-ghost" data-action="click->pictogram-autofill#closeModal">Annuler</button>
				</div>
			</div>
		</div>

		<div class="flex justify-center">
			<a href="#" data-pdf-url="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, v: (recipe.updatedAt ?? recipe.createdAt)|date('U')}) }}" class="btn btn-outline pdf-download-btn">
				{{ ux_icon('lucide:download', { class: 'size-5', 'aria-hidden': 'true' }) }}
				Télécharger le PDF
			</a>
		</div>
	</div>

	<!-- Toast de chargement PDF -->
	<div id="pdf-loading-toast" class="toast toast-top toast-center" style="display:none;">
		<div class="alert alert-info">
			<span class="loading loading-spinner"></span>
			<span>Génération du PDF en cours...</span>
		</div>
	</div>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const pdfButtons = document.querySelectorAll(".pdf-download-btn");
			const loadingToast = document.getElementById("pdf-loading-toast");

			pdfButtons.forEach(function (btn) {
				btn.addEventListener("click", function (e) {
					e.preventDefault();
					const url = this.getAttribute("data-pdf-url");

					if (url) {
						// Afficher le toast de chargement
						loadingToast.style.display = "block";

						// Désactiver tous les boutons PDF pendant le chargement
						pdfButtons.forEach(function (b) {
							b.classList.add("btn-disabled", "loading");
						});

						// Lancer le téléchargement
						window.location.href = url;

						// Masquer le toast après 3 secondes (le PDF devrait être prêt)
						setTimeout(function () {
							loadingToast.style.display = "none";
							pdfButtons.forEach(function (b) {
								b.classList.remove("btn-disabled", "loading");
							});
						}, 3000);
					}
				});
			});
		});
	</script>
{% endblock %}
