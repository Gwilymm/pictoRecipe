{% extends 'base.html.twig' %}

{% block title %}
	{{ recipe.title }}
	- Prévisualisation
{% endblock %}

{% block body %}
	<div
		class="container mx-auto px-4 py-4 md:py-6" data-controller="pictogram-autofill" data-pictogram-autofill-recipe-id-value="{{ recipe.id }}">
		{# Barre d'actions en haut: ajout d'un bouton Enregistrer et réorganisation #}
		<div class="flex flex-col sm:flex-row flex-wrap gap-2 md:gap-3 mb-4 md:mb-6 items-stretch sm:items-center justify-between">
			<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 md:gap-3">
				<a href="{{ path('app_recipe_index') }}" class="btn btn-outline btn-xs md:btn-sm">
					<span class="hidden sm:inline">← Retour à la liste</span>
					<span class="sm:hidden">← Liste</span>
				</a>
				<a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-outline btn-primary btn-xs md:btn-sm">
					<span class="hidden sm:inline">✏️ Modifier</span>
					<span class="sm:hidden">✏️ Éditer</span>
				</a>
			</div>
			<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 md:gap-3">
				<a href="#" data-pdf-url="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, v: (recipe.updatedAt ?? recipe.createdAt)|date('U')}) }}" class="btn btn-primary btn-xs md:btn-sm gap-2 pdf-download-btn" aria-label="Télécharger en PDF">
					<span class="hidden sm:inline">📄 Télécharger en PDF</span>
					<span class="sm:hidden">📄 PDF</span>
				</a>
				<button class="btn btn-ghost btn-sm md:btn-sm" data-action="click->pictogram-autofill#assign" data-pictogram-autofill-target="assignBtn">🖼️ Assigner les pictogrammes</button>
				<button class="btn btn-success btn-sm md:btn-sm" data-action="click->pictogram-autofill#validateAll" data-pictogram-autofill-target="validateAllBtn" disabled>✅ Valider tout</button>
			</div>
		</div>

		{# Inclusion du template de prévisualisation #}
		{{ include('recipe/_preview.html.twig', { recipe: recipe }) }}

		{# Hidden form so the preview can submit updates (pictogramUrl fields) via JS. It's hidden in preview to avoid duplicating UI. #}
		<div style="display:none;">
			<form id="preview-save-form" action="{{ path('app_recipe_edit', { id: recipe.id }) }}" method="POST">
				{{ form_widget(form) }}
				<button id="preview-save-btn" type="submit">Save</button>
			</form>
			<div data-pictogram-autofill-target="status" class="text-sm mt-2"></div>
		</div>

		{# Modal for suggestions #}
		<div id="pictogram-proposals-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50" aria-hidden="true">
			<div class="bg-base-100 rounded-lg p-4 max-w-3xl w-full shadow-lg">
				<div class="flex justify-between items-center mb-3">
					<h3 class="text-lg font-bold">Choisir un pictogramme</h3>
					<button class="btn btn-ghost btn-sm" data-action="click->pictogram-autofill#closeModal">Fermer</button>
				</div>
				<div id="pictogram-proposals-list" class="grid grid-cols-3 gap-2"></div>
				<div class="mt-3 text-right">
					<button class="btn btn-ghost" data-action="click->pictogram-autofill#closeModal">Annuler</button>
				</div>
			</div>
		</div>

		{# Actions en bas: Enregistrer en évidence #}
		<div class="flex flex-col sm:flex-row flex-wrap gap-2 md:gap-3 mt-4 md:mt-6 justify-center">
			<a href="{{ path('app_recipe_index') }}" class="btn btn-outline btn-sm md:btn-md">
				<span class="hidden sm:inline">← Retour à la liste</span>
				<span class="sm:hidden">← Liste</span>
			</a>

			<a href="#" data-pdf-url="{{ path('app_recipe_pdf', {id: recipe.id, download: 1, v: (recipe.updatedAt ?? recipe.createdAt)|date('U')}) }}" class="btn btn-primary btn-sm md:btn-md pdf-download-btn">
				<span class="hidden sm:inline">📄 Télécharger le PDF</span>
				<span class="sm:hidden">📄 PDF</span>
			</a>
		</div>
	</div>

	<!-- Toast de chargement PDF -->
	<div id="pdf-loading-toast" class="toast toast-top toast-center" style="display:none;">
		<div class="alert alert-info">
			<span class="loading loading-spinner"></span>
			<span>Génération du PDF en cours...</span>
		</div>
	</div>

	<script>
		document.addEventListener( 'DOMContentLoaded', function ()
{





const pdfButtons = document.querySelectorAll( '.pdf-download-btn' );
const loadingToast = document.getElementById( 'pdf-loading-toast' );

pdfButtons.forEach( function ( btn )
{





btn.addEventListener( 'click', function ( e )
{





e.preventDefault();
const url = this.getAttribute( 'data-pdf-url' );

if ( url )
{ // Afficher le toast de chargement
loadingToast.style.display = 'block';

// Désactiver tous les boutons PDF pendant le chargement
pdfButtons.forEach( function ( b )
{





b.classList.add( 'btn-disabled', 'loading' );





} );

// Lancer le téléchargement
window.location.href = url;

// Masquer le toast après 3 secondes (le PDF devrait être prêt)
setTimeout( function ()
{





loadingToast.style.display = 'none';
pdfButtons.forEach( function ( b )
{





b.classList.remove( 'btn-disabled', 'loading' );





} );





}, 3000 );





}

} );





} );





} );
	</script>
{% endblock %}
