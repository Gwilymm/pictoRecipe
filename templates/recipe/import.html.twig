{% extends 'base.html.twig' %}

{% block title %}Importer une recette{% endblock %}

{% block body %}
	<div class="mx-auto w-full max-w-4xl">
	<div class="space-y-6" data-controller="recipe-import">
		<div class="space-y-2">
			<a href="{{ path('app_recipe_new') }}" class="btn btn-ghost btn-sm -ml-3">
				{{ ux_icon('lucide:chevron-left', { class: 'size-4', 'aria-hidden': 'true' }) }}
				Nouvelle recette
			</a>
			<h1 class="text-2xl">Importer une recette</h1>
			<p class="text-muted">Collez l’adresse d’une recette Marmiton, Cuisine AZ ou Papilles &amp; Pupilles.</p>
		</div>

		<div class="space-y-6 rounded-box border border-base-300 bg-base-100 p-5 sm:p-6">
			<div class="space-y-2">
				<label for="recipe-import-url" class="font-bold">Adresse de la recette</label>
				<div class="flex flex-col gap-3 sm:flex-row">
					<input id="recipe-import-url" type="url" inputmode="url" placeholder="https://www.marmiton.org/recettes/…" class="input w-full" data-recipe-import-target="url" data-action="keydown.enter->recipe-import#fetchRecipe" aria-describedby="recipe-import-message"/>
					<button type="button" class="btn btn-outline shrink-0" data-action="click->recipe-import#fetchRecipe" data-recipe-import-target="fetchBtn">
						{{ ux_icon('lucide:search', { class: 'size-5', 'aria-hidden': 'true' }) }}
						Récupérer
					</button>
					<button type="button" class="btn btn-ghost shrink-0" data-action="click->recipe-import#clear">Effacer</button>
				</div>
				<p id="recipe-import-message" class="min-h-6 text-muted" data-recipe-import-target="message" aria-live="polite"></p>
			</div>

			<div data-recipe-import-target="preview"></div>

			<div class="flex justify-end">
				<button type="button" class="btn btn-primary hidden" data-recipe-import-target="importBtn" data-action="click->recipe-import#importRecipe">
					{{ ux_icon('lucide:download', { class: 'size-5', 'aria-hidden': 'true' }) }}
					Importer cette recette
				</button>
			</div>
		</div>
	</div>
	</div>
{% endblock %}
