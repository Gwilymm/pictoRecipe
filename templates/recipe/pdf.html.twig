<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>{{ recipe.title }}</title>
		<style>
			*
			{box-sizing:border-box;margin:0;padding:0
			}
			body
			{font-family:'DejaVu Sans',Arial,sans-serif;font-size:10pt;line-height:1.4;color:#000;padding:20px
			}

			h1
			{text-align:center;font-size:22pt;color:#222;margin-bottom:20px;text-transform:uppercase;border-bottom:3px solid #222;padding-bottom:6px
			}

			/* TITRES DE SECTION */
			h2
			{background:#f3f4f6;border-left:6px solid #2563eb;padding:6px 10px;font-size:13pt;margin:18px 0 8px
			}

			/* --- GRILLES INGREDIENTS & USTENSILES --- */
			.grid
			{width:100%;border-collapse:collapse;margin-bottom:15px
			}

			.grid td
			{border:2px solid #ddd;text-align:center;padding:8px;width:14%;vertical-align:top
			}

			.grid img
			{width:60px;height:60px;object-fit:contain;display:block;margin:0 auto 5px
			}

			<!DOCTYPE html> <html lang="fr"> <head> <meta charset="UTF-8"> <title>{{recipe.title}}</title > <style > *
			{box-sizing:border-box;margin:0;padding:0}
			body
			{font-family:'DejaVu Sans',Arial,sans-serif;font-size:10pt;line-height:1.4;color:#000;padding:20px}

			h1
			{text-align:center;font-size:22pt;color:#222;margin-bottom:20px;text-transform:uppercase;border-bottom:3px solid #222;padding-bottom:6px}

			/* TITRES DE SECTION */
			h2
			{background:#f3f4f6;border-left:6px solid #2563eb;padding:6px 10px;font-size:13pt;margin:18px 0 8px}

			/* --- GRILLES INGREDIENTS & USTENSILES --- */
			.grid
			{width:100%;border-collapse:collapse;margin-bottom:15px}

			.grid td
			{border:2px solid #ddd;text-align:center;padding:8px;width:14%;vertical-align:top}

			.grid img
			{width:60px;height:60px;object-fit:contain;display:block;margin:0 auto 5px}

			.grid span
			{display:block;font-size:9pt;font-weight:bold;color:#333}

			/* --- TABLEAU ÉTAPES --- */
			.steps
			{width:100%;border-collapse:collapse;margin-top:10px}

			.steps tr
			{border:2px solid #000;page-break-inside:avoid;/* avoid row split */
				break-inside:avoid;-webkit-column-break-inside:avoid;-webkit-page-break-inside:avoid}

			.steps td
			{border:2px solid #000;vertical-align:top;padding:10px;page-break-inside:avoid;break-inside:avoid}

			.num
			{width:60px;text-align:center;font-size:12pt;font-weight:bold;background:#dbeafe}

			.step-images
			{text-align:center;width:180px}

			.step-images img
			{width:70px;/* larger */
				height:70px;margin:4px;object-fit:contain;display:inline-block}

			.text
			{font-size:10pt;line-height:1.5}

			/* FOOTER */
			.footer
			{text-align:center;margin-top:20px;font-size:9pt;color:#555}
		</style>
	</head>
	<body>

		<h1>{{ recipe.title|upper }}</h1>

		{# -- Ingrédients -- #}
		<h2>Ingrédients</h2>
		<table class="grid">
			<tr>
				{% for ingredient in recipe.ingredients %}
					<td>
						{% if ingredient.pictogramUrl %}
							<img src="{{ ingredient.pictogramUrl }}" alt="{{ ingredient.name }}">
						{% else %}
							<div style="width:60px;height:60px;background:#e5e7eb;border-radius:6px;margin:0 auto 6px;"></div>
						{% endif %}
						<span>{{ ingredient.name }}</span>
						{% if ingredient.amount %}
							<div style="font-size:8.5pt;color:#2563eb;">
								{{ ingredient.amount }}
								{{ ingredient.unit|default('') }}
							</div>
						{% endif %}
					</td>
					{% if loop.index is divisible by(6) %}
					</tr>
					<tr>
					{% endif %}
				{% endfor %}
			</tr>
		</table>

		{# -- Ustensiles -- #}
		<h2>Ustensiles</h2>
		<table class="grid">
			<tr>
				{% for utensil in recipe.utensils %}
					<td>
						{% if utensil.pictogramUrl %}
							<img src="{{ utensil.pictogramUrl }}" alt="{{ utensil.name }}">
						{% else %}
							<div style="width:50px;height:50px;background:#fef3c7;border-radius:6px;margin:0 auto 5px;"></div>
						{% endif %}
						<span>{{ utensil.name }}</span>
					</td>
					{% if loop.index is divisible by(6) %}
					</tr>
					<tr>
					{% endif %}
				{% endfor %}
			</tr>
		</table>

		{# -- Préparation -- #}
		<h2>Préparation</h2>
		<table class="steps">
			{% for step in recipe.steps %}
				<tr>
					<td class="num">{{ loop.index }}</td>
					<td class="step-images">
						{% if step.pictogramUrls and step.pictogramUrls is not empty %}
							{% for url in step.pictogramUrls %}
								<img src="{{ url }}" alt="picto">
							{% endfor %}
						{% elseif step.pictogramUrl %}
							<img src="{{ step.pictogramUrl }}" alt="picto">
						{% else %}
							<div style="width:50px;height:50px;background:#e5e7eb;border-radius:8px;margin:auto;"></div>
						{% endif %}
					</td>
					<td class="text">{{ step.content }}</td>
				</tr>
			{% endfor %}
		</table>

		<div class="footer">
			<p>Bonne dégustation ! 🍰</p>
			<p>Recette créée avec
				<strong>PictoRecipe</strong>
				•
				{{ "now"|date("d/m/Y") }}</p>
		</div>
	</body>
</html>
