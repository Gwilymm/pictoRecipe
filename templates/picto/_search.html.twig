{# Partial Twig for Picto search using OpenFoodFacts #}
<div data-controller="picto-search" class="space-y-3">
    <input data-picto-search-target="input" type="search" placeholder="Rechercher un produit (ex: tomate)" class="input input-bordered w-full" />
    <div data-picto-search-target="results" class="w-full"></div>
</div>

