<form method="post" action="{{ path('app_step_delete', {'id': step.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette étape ?');" class="inline">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ step.id) }}">
	<button class="btn btn-error">Supprimer</button>
</form>
