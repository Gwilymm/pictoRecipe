{% extends 'base.html.twig' %}

{% block title %}Modifier un Ustensile
{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-6 max-w-2xl">
		<h1 class="text-3xl font-bold mb-6">✏️ Modifier l'Ustensile</h1>

		{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="form-control">
					{{ form_row(form.name) }}
				</div>

				<div class="divider">Pictogramme</div>

				<div class="form-control">
					{{ include('partials/_pictogram_widget.html.twig', {
						'form_field': form.name,
						'url_field': form.pictogramUrl,
						'placeholder': 'Rechercher un pictogramme pour cet ustensile...'
						
					}) }}
				</div>

				<div class="card-actions justify-end mt-4">
					<div class="flex gap-2">
						<a href="{{ path('app_utensil_index') }}" class="btn btn-outline">
							Annuler
						</a>
						<button type="submit" class="btn btn-primary">
							💾 Enregistrer
						</button>
					</div>
				</div>
			</div>
		</div>

		{{ form_end(form) }}

		{# Delete form moved outside the item form to avoid nested forms which can break CSRF or submission #}
		<form method="post" action="{{ path('app_utensil_delete', {'id': utensil.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet ustensile ?');" class="mt-4">
			<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ utensil.id) }}">
			<button type="submit" class="btn btn-error">
				🗑️ Supprimer
			</button>
		</form>
	</div>
{% endblock %}
