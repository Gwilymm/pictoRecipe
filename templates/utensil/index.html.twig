{% extends 'base.html.twig' %}

{% block title %}Ustensiles{% endblock %}

{% block body %}
	{% import '_ds/_ui.html.twig' as ui %}
	<div class="space-y-6" data-controller="utensil-filter">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<h1 class="text-2xl">Ustensiles</h1>
			<a href="{{ path('app_utensil_new') }}" class="btn btn-primary">
				{{ ux_icon('lucide:plus', { class: 'size-5', 'aria-hidden': 'true' }) }}
				Ajouter un ustensile
			</a>
		</div>

		{% if utensils is empty %}
			{{ ui.empty_state('Aucun ustensile pour l’instant.') }}
		{% else %}
			{{ ui.filter_search('utensil-filter', 'ustensiles', utensils|length) }}

			<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8" data-utensil-filter-target="grid">
				{% for utensil in utensils %}
					<li class="flex flex-col gap-3 rounded-box border border-base-300 border-t-4 border-t-secondary bg-base-100 p-3 text-center"
						data-utensil-filter-target="card"
						data-name="{{ utensil.name|lower }}">
						<div class="picto-tile w-full">
							{% set src = ui.picto_src(utensil)|trim %}
							{% if src %}
								<img src="{{ src }}" alt="" loading="lazy">
							{% else %}
								{{ ux_icon('lucide:image', { class: 'size-1/3 text-base-300', 'aria-hidden': 'true' }) }}
							{% endif %}
						</div>
						<h2 class="line-clamp-2 text-sm font-bold leading-tight">{{ utensil.name }}</h2>
						<a href="{{ path('app_utensil_edit', {id: utensil.id}) }}" class="btn btn-sm btn-outline mt-auto" aria-label="Modifier {{ utensil.name }}">
							{{ ux_icon('lucide:pencil', { class: 'size-5', 'aria-hidden': 'true' }) }}
							Modifier
						</a>
					</li>
				{% endfor %}
			</ul>

			{{ ui.filter_footer('utensil-filter', 'ustensile') }}
		{% endif %}
	</div>
{% endblock %}
