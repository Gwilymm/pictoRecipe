{% extends 'base.html.twig' %}

{% block title %}Ajouter un ustensile{% endblock %}

{% block body %}
	{% import '_ds/_ui.html.twig' as ui %}
	<div class="mx-auto max-w-2xl">
		<h1 class="mb-6 text-2xl">Ajouter un ustensile</h1>

		{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

		<div class="card bg-base-100 shadow">
			<div class="card-body">
				<div class="form-control">
					{{ form_row(form.name) }}
				</div>

				<div class="divider">Image</div>

				<div class="form-control" data-controller="picto-search">
					<label for="utensil-picto-q" class="font-semibold">Rechercher une image (OpenFoodFacts, Wikimedia)</label>

					<div class="space-y-3">
						<input id="utensil-picto-q" type="search" data-picto-search-target="input" placeholder="Ex: spatule, casserole, verre..." class="input input-bordered w-full"/>

						{{ ui.source_filters() }}

						{{ form_widget(form.pictogramUrl, {
							'attr': {
								'data-picto-search-target': 'urlInput'
							}
						}) }}

						<div data-picto-search-target="status" class="text-sm min-h-5"></div>
						<div data-picto-search-target="results" class="grid grid-cols-3 sm:grid-cols-4 gap-3 overflow-visible"></div>
						<div data-picto-search-target="pagination"></div>
					</div>
				</div>

				<div id="utensil-external-preview" class="mt-3"></div>

				<div class="card-actions justify-end mt-4">
					<a href="{{ path('app_utensil_index') }}" class="btn btn-outline">
						Annuler
					</a>
					<button type="submit" class="btn btn-primary">
						Enregistrer
					</button>
				</div>
			</div>
		</div>

		{{ form_end(form) }}

		<script>
			// Aperçu de l'image choisie (données OpenFoodFacts / Wikimedia : construites via le DOM, sans innerHTML)
			document.addEventListener('picto:selected', (e) => {
				const item = e.detail;
				const preview = document.getElementById('utensil-external-preview');
				if (!preview || !item) return;
				const tile = document.createElement('div');
				tile.className = 'picto-tile w-24';
				const img = document.createElement('img');
				img.src = item.image || '';
				img.alt = '';
				tile.appendChild(img);
				const name = document.createElement('p');
				name.className = 'mt-1 text-sm text-muted';
				name.textContent = item.name || '';
				preview.replaceChildren(tile, name);
			});
		</script>
	</div>
{% endblock %}
